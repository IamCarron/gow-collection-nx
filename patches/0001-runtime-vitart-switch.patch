+// rec_sync() esvaziar a fila: o command buffer (e o pool dele) nunca é usado pelas duas threads ao mesmo tempo, e a
+// ordem dos comandos é a mesma de antes. VITART_VK_THREAD=0 grava tudo na thread do jogo, como antes.
+struct RecCopy {
+    uint8_t *dst;
+    const void *src;
+    uint32_t n;
+};
+struct RecOp {
+    uint32_t ncp = 0;   // desenho: cópias adiadas para o anel (feitas pela thread de gravação antes de gravar)
+    RecCopy cp[19];
+    uint32_t kind = 0;  // 0 desenho, 1 começa render pass, 2 termina render pass
+    uint32_t flags = 0; // desenho: 1 pipeline, 2 viewport, 4 scissor, 8 PBR, bits 16..21 stencil
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    VkPipeline pipe = VK_NULL_HANDLE;
+    VkDescriptorSet sets[3] = {};
+    uint32_t dyn[4] = {};
+    VkViewport vp{};
+    VkRect2D sc{};
+    uint32_t sten[6] = {};
+    VkDescriptorSet s34[2] = {};
+    uint32_t poff = 0;
+    uint32_t na = 0;
+    VkIndexType itype = VK_INDEX_TYPE_UINT32;
+    uint32_t index_count = 0;
+    int32_t vertex_offset = 0;
+    VkDeviceSize ioff = 0;
+    VkDeviceSize voff[16] = {};
