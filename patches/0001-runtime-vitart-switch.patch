+        if (std::fread(magic, 1, 8, k->f) != 8 || std::memcmp(magic, "SPVPAK1", 8) || std::fread(&n, 4, 1, k->f) != 1) {
+            std::fclose(k->f), k->f = nullptr;
+            return k;
+        }
+        struct E {
+            char name[28];
+            uint32_t size;
+            uint64_t off;
+        };
+        std::vector<E> es(n);
+        if (std::fread(es.data(), sizeof(E), n, k->f) != n) {
+            std::fclose(k->f), k->f = nullptr;
+            return k;
+        }
+        k->idx.reserve(n);
+        for (const E &e : es) k->idx[std::string(e.name, strnlen(e.name, sizeof e.name))] = {e.off, e.size};
