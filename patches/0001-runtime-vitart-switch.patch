+void set_gfx(uint32_t id, uint32_t v);
+uint32_t gfx(uint32_t id);
+// Resolução dinâmica: baixa a escala interna em degraus quando a GPU não cabe no quadro (fps 1 = 30, senão 60) e
+// volta até a escolhida quando sobra folga.
+void set_dynamic_res(uint32_t on, uint32_t fps);
 // Ultrawide: quanto os alvos de tela ficam mais largos que os 720x408 do jogo (1 = 16:9 do jogo). O jogo desenha com
 // a câmera na proporção nova (game_options.cpp) e o HUD encolhe de volta (hle_gxm.cpp, squeeze_hud).
 float aspect_widen();
@@ -38,6 +56,15 @@ uint32_t measured_fps();
 // Janela sem bordas ocupando o monitor (o mesmo modo do F11 / Alt+Enter).
 void set_borderless(bool on);
 // VSync do menu de pausa: desligado, a apresentação não espera o vblank (modo imediato).
+// Geração de quadros (LSFG, só deko3d): 0 desligada, 1 desempenho, 2 qualidade. available: há cache de shaders.
+void set_frame_gen(uint32_t mode);
+bool frame_gen_available(uint32_t mode);
+// Diagnóstico de GPU por desenho (só deko3d; ranking no log). gpu_diag: -1 indisponível, 0 desligado, 1 ligado.
+void set_gpu_diag(bool on);
+// Fluxo óptico da geração de quadros em 1/den da resolução (1..4; sem cache daquele den usa 1).
+void set_frame_gen_flow(uint32_t den);
+uint32_t frame_gen_flow();
+int gpu_diag();
 void set_vsync(bool on, bool fifo = false); // fifo: esperar o vblank do monitor (VSync com FPS máximo)
 // Desenhos que gravaram profundidade no último quadro apresentado (0 em telas 2D, como o menu principal).
 uint32_t last_frame_depth_writes();
@@ -50,6 +77,9 @@ void post_focus_values(float out[4]); // foco, alvo, distância e profundidade n
 // Próximo present mostra esta imagem RGBA (cena remasterizada) no lugar do alvo do jogo. O ponteiro tem
 // de valer até o present.
 void set_video_frame(const uint8_t *rgba, uint32_t w, uint32_t h);
+// O mesmo em NV12 do NVDEC (Switch, video_hd_nx.cpp): plano Y com pitch em bytes e plano UV intercalado a partir
+// de uv_offset; flags: 1 = P010 (16 bits por amostra), 2 = faixa cheia, 4 = BT.601. A conversão é feita na GPU.
+void set_video_frame_nv12(const uint8_t *data, uint32_t w, uint32_t h, uint32_t pitch, uint32_t uv_offset, uint32_t flags);
 // Aviso de troféu igual ao do PS Vita (ícone, nível, nome), desenhado sobre o quadro.
 void notify_trophy(const TrophyBanner &t);
 bool is_borderless();
