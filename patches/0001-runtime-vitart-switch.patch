+        vkCmdDispatch(g_pcmd, (dw + 7) / 8, (dh + 7) / 8, 1);
+        if (!i) fsr_compute_barrier();
+    }
+    barrier(g_fsr_b, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    static uint32_t lw = 0, lh = 0, lsw = 0;
+    if (lw != dw || lh != dh || lsw != src.w) {
+        vt::logf("vk: FSR %ux%u -> %ux%u, nitidez %u", src.w, src.h, dw, dh, g_ups_sharp.load());
+        lw = dw, lh = dh, lsw = src.w;
+    }
+    return &g_fsr_b;
+}
