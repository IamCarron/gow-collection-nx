diff --git a/runtime/vitart/gxm_api.inc b/runtime/vitart/gxm_api.inc
index 5b607ac..658d2f9 100644
--- a/runtime/vitart/gxm_api.inc
+++ b/runtime/vitart/gxm_api.inc
@@ -18,6 +18,10 @@ bool has_focus();
 void notify(const std::string &text);
 bool is_target(uint32_t addr);
 bool is_depth(uint32_t addr);
+// is_target/is_depth numa consulta só: 0 nada, 1 alvo de cor, 2 superfície de profundidade.
+int target_kind(uint32_t addr);
+// Espera as cópias adiadas do anel (dados na memória do guest) terminarem: antes de o jogo poder reusar os buffers.
+void sync_copies();
 // Início de cena do GXM: a profundidade do alvo volta ao valor de fundo (1,0), a não ser que a
 // superfície peça "force load". Sem isso a profundidade de uma cena vaza para a seguinte.
 void begin_scene(uint32_t color_addr, uint8_t stencil = 0);
@@ -26,6 +30,20 @@ void shutdown();
 uint32_t render_scale();
 uint32_t auto_render_scale();
 bool set_render_scale(uint32_t s);
+// Escala fracionária (720p = 720/408 = 1,765x).
+bool set_render_scale_f(float s);
+// Escalonamento na apresentação: 0 bilinear, 1 FSR 1.0 (EASU + RCAS) com nitidez 0..10.
+void set_upscaler(uint32_t mode, uint32_t sharp);
+// Opções gráficas do pós-processamento (só deko3d; nos outros não fazem nada): ids abaixo, valores
+//   AA 0/1 (FXAA), Upscale 0 bilinear / 1 FSR 1.0, Sharp 0..10 (RCAS, 0 = sem), Aniso 1/2/4/8/16,
+//   Gamma 0..8 (brilho, 4 = neutro), Sat 0..8 (saturação, 4 = neutro), Vibrance 0..2, Dither 0/1.
+constexpr uint32_t kGfxAA = 0, kGfxUpscale = 1, kGfxSharp = 2, kGfxAniso = 3, kGfxGamma = 4, kGfxSat = 5, kGfxVibrance = 6,
