+// ---------------------------------------------------------------- resolução dinâmica
+// O tempo de GPU de cada quadro (carimbos dos command buffers, g_drs_ns) é somado em janelas de 20 quadros. Se a média
+// passa de 80% do orçamento (33,3 ms a 30 fps, 16,7 ms a 60) ou 3 quadros da janela estouram 95%, desce um degrau da
+// escala; se a média projetada no degrau de cima (pela área) cabe em 65%, por 3 janelas seguidas, sobe. Entre trocas,
+// pelo menos 1 s para descer e 3 s para subir. Cada troca é um refazer_alvos (um quadro de engasgo, sem tela preta).
+static std::atomic<uint32_t> g_drs_on{0}, g_drs_fps{1};
+#define g_drs_ns g_drs_ns_pub
+static int g_drs_level = 0;   // 0 = escala escolhida
+#define g_drs_scale g_drs_scale_pub // escala em uso pela resolução dinâmica (0 = nenhuma)
+static const float kDrsStep[] = {1.f, 0.87f, 0.76f, 0.66f, 0.57f};
+constexpr int kDrsLevels = sizeof kDrsStep / sizeof kDrsStep[0];
+void set_dynamic_res(uint32_t on, uint32_t fps) { g_drs_on = on ? 1u : 0u, g_drs_fps = fps; }
+static float drs_base() { return g_scale_override > 0 ? g_scale_override : scale_auto(); }
+static float drs_scale_of(int level) {
+    const float s = drs_base() * kDrsStep[level];
+    return s < 1.f ? 1.f : s;
+}
+static void drs_tick() {
+    static uint64_t last_ns = 0;
+    static uint32_t frames = 0, over = 0, cool = 0, up_ok = 0, logs = 0;
+    static double sum = 0;
+    const double ms = (double)(g_drs_ns - last_ns) / 1e6;
+    last_ns = g_drs_ns;
+    if (cool) cool--;
+    const float base = drs_base();
+    if (!g_drs_on || base <= 1.001f) {
+        if (g_drs_level) {
+            g_drs_level = 0;
+            g_drs_scale = 0;
+            refazer_alvos(base, g_widen);
+            vt::logf("vk: resolução dinâmica desligada, de volta a %.2fx", base);
+        }
+        frames = over = up_ok = 0, sum = 0;
+        return;
+    }
+    const double budget = g_drs_fps.load() == 1 ? 1000.0 / 30 : 1000.0 / 60;
+    sum += ms, frames++;
+    if (ms > budget * 0.95) over++;
+    if (frames < 20) return;
+    const double avg = sum / frames;
+    const uint32_t ov = over;
+    frames = over = 0, sum = 0;
+    int want = g_drs_level;
+    if ((avg > budget * 0.80 || ov >= 3) && g_drs_level + 1 < kDrsLevels && drs_scale_of(g_drs_level + 1) < drs_scale_of(g_drs_level) - 0.01f) {
+        up_ok = 0;
+        if (cool <= 40) want = g_drs_level + 1; // 1 s (60 quadros) depois da última troca
+    } else if (g_drs_level > 0) {
+        const double r = drs_scale_of(g_drs_level - 1) / drs_scale_of(g_drs_level);
+        if (avg * r * r < budget * 0.65) {
+            if (++up_ok >= 3 && !cool) want = g_drs_level - 1, up_ok = 0;
+        } else
+            up_ok = 0;
+    }
+    if (want == g_drs_level) return;
+    const float s = drs_scale_of(want);
+    if (!refazer_alvos(s, g_widen)) return;
+    if (logs++ < 60)
+        vt::logf("vk: resolução dinâmica %.2fx -> %.2fx (GPU %.1f ms de média, %u acima do limite)", scale_now(), s, avg, ov);
+    g_drs_level = want;
+    g_drs_scale = want ? s : 0;
+    cool = 180; // 3 s
+}
