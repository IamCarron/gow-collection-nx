+
+void rec_worker() {
+    uint32_t t = g_rq_tail.load();
+    for (;;) {
+        uint32_t h = g_rq_head.load();
+        if (h == t) {
+            // fila vazia: espera ativa curta (o próximo desenho chega em dezenas de µs), depois dorme
+            const uint64_t until = now_ns() + 60000;
+            while ((h = g_rq_head.load(std::memory_order_acquire)) == t && now_ns() < until) {
+            }
+            if (h == t) {
+                std::unique_lock<std::mutex> lk(g_rq_m);
+                g_rq_sleep.store(true);
+                while ((h = g_rq_head.load()) == t) g_rq_work.wait(lk);
+                g_rq_sleep.store(false);
+            }
+        }
+        const uint64_t t0 = now_ns();
+        while (t != h) {
+            rec_exec(g_rq[t % kRecCap]);
+            g_rq_tail.store(++t);
+            if (t == h) h = g_rq_head.load(std::memory_order_acquire);
+        }
+        g_rec_ns += now_ns() - t0;
+        if (g_rq_wait.load()) {
+            std::lock_guard<std::mutex> lk(g_rq_m);
+            g_rq_done.notify_one();
+        }
+    }
+}
+
+void rec_sync() {
+    if (!g_rec_on) return;
+    const uint32_t h = g_rq_head.load(std::memory_order_relaxed);
+    if (g_rq_tail.load(std::memory_order_acquire) == h) return;
+    const uint64_t t0 = now_ns();
+    std::unique_lock<std::mutex> lk(g_rq_m);
+    if (g_rq_sleep.load()) g_rq_work.notify_one();
+    g_rq_wait.store(true);
+    while (g_rq_tail.load() != h) g_rq_done.wait(lk);
+    g_rq_wait.store(false);
+    g_sync_ns += now_ns() - t0;
+}
+
+// Vaga para o próximo registro (só a thread que tem g_lock grava na fila); rec_commit publica.
+RecOp &rec_slot() {
+    if (!g_rec_on) return g_rq_local = RecOp{};
+    const uint32_t h = g_rq_head.load(std::memory_order_relaxed);
+    if (h - g_rq_tail.load(std::memory_order_acquire) >= kRecCap) rec_sync();
+    return g_rq[h % kRecCap] = RecOp{};
+}
+void rec_commit() {
+    if (!g_rec_on) {
+        rec_exec(g_rq_local);
+        return;
+    }
+    const uint32_t h = g_rq_head.load(std::memory_order_relaxed) + 1;
+    g_rq_head.store(h);
+    // Com a gravadora dormindo, só a acorda com 8 registros pendentes (rec_sync acorda para o resto): menos idas ao
+    // kernel por desenho na thread Render.
+    if (g_rq_sleep.load() && h - g_rq_tail.load(std::memory_order_relaxed) >= 8) {
+        std::lock_guard<std::mutex> lk(g_rq_m);
+        g_rq_work.notify_one();
+    }
+}
+
+void rec_start() {
+    const char *e = getenv("VITART_VK_THREAD");
+    if (e && *e == '0') {
+        vt::logf("vk: gravação na thread do jogo (VITART_VK_THREAD=0)");
+        return;
+    }
+    g_rq = new RecOp[kRecCap];
+    g_rec_on = true;
+#ifdef __SWITCH__
+    vt::spawn_detached(rec_worker, "gravacao vk");
+#else
+    std::thread(rec_worker).detach();
+#endif
+    vt::logf("vk: gravação de comandos em thread separada");
