+    VkPushConstantRange pr{VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(FsrPush)};
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1;
+    pl.pSetLayouts = &g_fsr_dsl;
+    pl.pushConstantRangeCount = 1;
+    pl.pPushConstantRanges = &pr;
+    VKC(vkCreatePipelineLayout(g_dev, &pl, nullptr, &g_fsr_layout));
+    const uint32_t *code[2] = {kFsr_easu, kFsr_rcas};
+    const size_t size[2] = {sizeof kFsr_easu, sizeof kFsr_rcas};
+    for (uint32_t i = 0; i < 2; i++) {
+        VkShaderModuleCreateInfo mi{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        mi.codeSize = size[i];
+        mi.pCode = code[i];
