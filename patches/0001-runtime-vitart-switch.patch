+namespace vt {
+void logf(const char *fmt, ...); // core.cpp
+void log_flush();
+}
+
+// Diagnóstico: os últimos passos ficam num anel na memória e vão para o log quando o deko3d acusa erro (o erro da
+// GPU só aparece um quadro depois, na espera da fence). Os primeiros VITART_DK_TRACE passos (padrão 40) também vão
+// direto para o arquivo.
+static int g_trace = -1;
+static char g_tr[512][224];
+static uint32_t g_tr_n = 0;
+static int g_ring = -1; // anel de passos ligado (VITART_DK_RING=1): o snprintf por draw custa caro na CPU
+#define DKT(...)                                                                                                           do {                                                                                                                       if (g_trace < 0) {                                                                                                         g_trace = getenv("VITART_DK_TRACE") ? atoi(getenv("VITART_DK_TRACE")) : 40;                                            g_ring = getenv("VITART_DK_RING") ? atoi(getenv("VITART_DK_RING")) : 0;                                            }                                                                                                                      if (g_trace > 0 || g_ring > 0) {                                                                                           std::snprintf(g_tr[g_tr_n++ % 512], 224, __VA_ARGS__);                                                                 if (g_trace > 0) {                                                                                                         g_trace--;                                                                                                             vt::logf("dkt: %s", g_tr[(g_tr_n - 1) % 512]);                                                                         vt::log_flush();                                                                                                   }                                                                                                                  }                                                                                                                  } while (0)
+static void dkt_dump() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    const uint32_t n = g_tr_n < 512 ? g_tr_n : 512;
+    vt::logf("dk: últimos %u passos antes do erro:", n);
+    for (uint32_t i = g_tr_n - n; i != g_tr_n; i++) vt::logf("dkt %u: %s", i, g_tr[i % 512]);
+    vt::log_flush();
+}
+
+namespace gvk::dk {
+namespace {
+
+std::recursive_mutex g_lock;
+std::string g_err;
+DkDevice g_dev = nullptr;
+DkQueue g_queue = nullptr;
+
+uint64_t now_ns() { return armTicksToNs(armGetSystemTick()); }
+struct Timer {
+    uint64_t &acc, t0;
+    explicit Timer(uint64_t &a) : acc(a), t0(now_ns()) {}
+    ~Timer() { acc += now_ns() - t0; }
+};
+Stats g_stats;
+
+uint64_t fnv(const void *p, size_t n, uint64_t h = 0xCBF29CE484222325ull) {
+    const uint8_t *b = static_cast<const uint8_t *>(p);
+    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 0x100000001B3ull;
+    return h;
+}
+
+bool fail(const char *what) {
+    g_err = what;
+    vt::logf("dk: %s", what);
+    return false;
+}
+
+void dbg_cb(void *, const char *ctx, DkResult r, const char *msg) {
+    dkt_dump();
+    vt::logf("dk: erro do deko3d em %s: %d %s", ctx ? ctx : "?", (int)r, msg ? msg : "");
+    vt::log_flush();
+}
+
+DkMemBlock mem_block(uint32_t size, uint32_t flags) {
+    DkMemBlockMaker m;
+    dkMemBlockMakerDefaults(&m, g_dev, (size + DK_MEMBLOCK_ALIGNMENT - 1) & ~(DK_MEMBLOCK_ALIGNMENT - 1));
+    m.flags = flags;
+    return dkMemBlockCreate(&m);
+}
+
+// ---------------------------------------------------------------- heap de imagens
+// Blocos grandes com lista de livres (offset -> tamanho), primeiro que couber; imagem maior que o bloco ganha um só
+// dela.
+struct Alloc {
+    int block = -1;
+    uint32_t off = 0, size = 0;
+};
+struct Heap {
+    uint32_t flags = 0, chunk = 64u << 20;
+    std::vector<DkMemBlock> blocks;
+    std::vector<std::map<uint32_t, uint32_t>> free;
+
+    bool alloc(uint32_t size, uint32_t align, Alloc &a) {
+        size = (size + 255) & ~255u;
+        if (align < 256) align = 256;
+        for (size_t b = 0; b < blocks.size(); b++) {
+            auto &fl = free[b];
+            for (auto it = fl.begin(); it != fl.end(); ++it) {
+                const uint32_t start = (it->first + align - 1) & ~(align - 1), end = it->first + it->second;
+                if (start + size > end) continue;
+                const uint32_t o = it->first;
+                fl.erase(it);
+                if (start > o) fl[o] = start - o;
+                if (start + size < end) fl[start + size] = end - start - size;
+                a = {(int)b, start, size};
+                return true;
+            }
+        }
+        const uint32_t bs = std::max(chunk, (size + align + 0xFFFFu) & ~0xFFFFu);
+        DkMemBlock mb = mem_block(bs, flags);
+        if (!mb) return false;
+        blocks.push_back(mb);
+        free.emplace_back();
+        free.back()[0] = bs;
+        return alloc(size, align, a);
+    }
+    void release(const Alloc &a) {
+        if (a.block < 0) return;
+        auto &fl = free[a.block];
+        uint32_t o = a.off, s = a.size;
+        auto nx = fl.lower_bound(o);
+        if (nx != fl.end() && o + s == nx->first) s += nx->second, nx = fl.erase(nx);
+        if (nx != fl.begin()) {
+            auto pv = std::prev(nx);
+            if (pv->first + pv->second == o) o = pv->first, s += pv->second, fl.erase(pv);
+        }
+        fl[o] = s;
+    }
+    DkMemBlock block(const Alloc &a) const { return blocks[a.block]; }
+};
+Heap g_img_heap;
+
+// ---------------------------------------------------------------- descritores
+constexpr uint32_t kMaxImgDesc = 16384, kMaxSmpDesc = 512;
+DkMemBlock g_desc_mem = nullptr;
+DkImageDescriptor *g_img_desc = nullptr;
+DkSamplerDescriptor *g_smp_desc = nullptr;
+DkGpuAddr g_img_desc_gpu = 0, g_smp_desc_gpu = 0;
+std::vector<uint32_t> g_img_desc_free;
+uint32_t g_smp_count = 0;
+std::unordered_map<uint32_t, uint32_t> g_samplers; // chave -> índice
+
+struct Img {
+    DkImageLayout lay;
+    DkImage im;
+    Alloc a;
+    uint32_t w = 0, h = 0, mips = 1;
+    DkImageFormat fmt = DkImageFormat_None;
+    uint32_t desc = UINT32_MAX; // descritor de amostragem
+    bool ok = false;
+};
+
+void img_free(Img &im) {
+    if (!im.ok) return;
+    g_img_heap.release(im.a);
+    if (im.desc != UINT32_MAX) g_img_desc_free.push_back(im.desc);
+    im = Img{};
+}
+
+bool img_make(Img &im, uint32_t w, uint32_t h, DkImageFormat fmt, uint32_t flags, uint32_t mips = 1) {
+    DkImageLayoutMaker lm;
+    dkImageLayoutMakerDefaults(&lm, g_dev);
+    lm.flags = flags;
+    lm.format = fmt;
+    lm.dimensions[0] = w, lm.dimensions[1] = h;
+    lm.mipLevels = mips;
+    dkImageLayoutInitialize(&im.lay, &lm);
+    if (!g_img_heap.alloc((uint32_t)dkImageLayoutGetSize(&im.lay), dkImageLayoutGetAlignment(&im.lay), im.a))
+        return fail("sem memória para imagem");
+    dkImageInitialize(&im.im, &im.lay, g_img_heap.block(im.a), im.a.off);
+    im.w = w, im.h = h, im.mips = mips, im.fmt = fmt, im.ok = true;
+    if (g_img_desc_free.empty()) return fail("sem descritores de imagem");
+    im.desc = g_img_desc_free.back();
+    g_img_desc_free.pop_back();
+    DkImageView v;
+    dkImageViewDefaults(&v, &im.im);
+    dkImageDescriptorInitialize(&g_img_desc[im.desc], &v, false, false);
+    return true;
+}
+
+// Filtro anisotrópico (opção gráfica): 1 = desligado, senão 2/4/8/16 amostras nos samplers lineares com mip. Entra na
+// chave: trocar a opção cria samplers novos (os antigos ficam na tabela, que tem folga).
+std::atomic<uint32_t> g_aniso{1};
+uint32_t sampler_idx(bool lin_mag, bool lin_min, uint32_t au, uint32_t av, bool mipped, bool mip_lin, uint32_t bias) {
+    const uint32_t an = mipped && lin_min ? g_aniso.load() : 1;
+    const uint32_t key = lin_mag | lin_min << 1 | (au & 7) << 2 | (av & 7) << 5 | (uint32_t)mipped << 8 | (uint32_t)mip_lin << 9 |
+                         (bias & 63) << 10 | an << 16;
+    auto it = g_samplers.find(key);
+    if (it != g_samplers.end()) return it->second;
+    if (g_smp_count >= kMaxSmpDesc) return 0;
+    auto wrap = [](uint32_t m) {
+        switch (m) {
+        case 0: case 4: return DkWrapMode_Repeat;
+        case 1: return DkWrapMode_MirroredRepeat;
+        case 5: return DkWrapMode_ClampToBorder;
+        default: return DkWrapMode_ClampToEdge;
+        }
+    };
+    DkSampler s;
+    dkSamplerDefaults(&s);
+    s.magFilter = lin_mag ? DkFilter_Linear : DkFilter_Nearest;
+    s.minFilter = lin_min ? DkFilter_Linear : DkFilter_Nearest;
+    s.mipFilter = mipped ? (mip_lin ? DkMipFilter_Linear : DkMipFilter_Nearest) : DkMipFilter_None;
+    s.wrapMode[0] = wrap(au), s.wrapMode[1] = wrap(av), s.wrapMode[2] = DkWrapMode_ClampToEdge;
+    s.lodClampMax = mipped ? 1000.f : 0.25f;
+    s.lodBias = mipped ? ((float)(bias & 63) - 31.f) / 8.f : 0.f;
+    if (an > 1) s.maxAnisotropy = (float)an;
+    const uint32_t i = g_smp_count++;
+    dkSamplerDescriptorInitialize(&g_smp_desc[i], &s);
+    return g_samplers[key] = i;
+}
+
+// ---------------------------------------------------------------- vagas do quadro: anel de dados e comandos
+constexpr uint32_t kSlots = 2;
+constexpr uint32_t kRing = 48u << 20, kRingSlack = 1u << 20; // a janela dos uniforms (1 MB) pode passar do fim
+constexpr uint32_t kUBWindow = 1u << 20;
+constexpr uint32_t kCmdMem = 4u << 20, kCmdChunk = 256u << 10;
+struct Slot {
+    DkMemBlock ring = nullptr, cmd = nullptr, up = nullptr, ts = nullptr;
+    uint8_t *ring_cpu = nullptr;
+    DkGpuAddr ring_gpu = 0;
+    uint32_t cmd_used = 0, up_used = 0;
+    std::vector<DkMemBlock> extra; // memória de comandos além da reservada (liberada quando a vaga volta)
+    DkFence fence;
+    bool pending = false;
+    bool mid = false; // carimbo de "fim dos desenhos" (antes da apresentação) gravado nesta vaga
+    uint32_t waits = 0; // pares de carimbos em volta da espera da imagem da swapchain (bit por passada)
+};
+Slot g_slots[kSlots];
+// Opções de teste no vitart_options.ini: dk_tile=N (cache em ladrilhos NxN, 0 desliga), dk_depth=24|32
+uint32_t g_tile = 64;
+bool g_z24 = true;
+// Tempo de GPU por alvo: carimbos a cada troca de alvo (ou cópia), a partir do byte 48 do bloco de carimbos da vaga
+constexpr uint32_t kMarks = 240;
+constexpr uint32_t kWaitTs = 48 + 16 * kMarks; // 2 passadas x (antes, depois) da espera da swapchain
+uint32_t g_mark_key[2][kMarks];
+uint32_t g_nmarks[2] = {};
+uint32_t g_cur_key = 0;
+struct PassAcc { uint64_t ns = 0; uint32_t n = 0; };
+std::map<uint32_t, PassAcc> g_pass;
+uint64_t g_gpu_draw_ns = 0, g_gpu_all_ns = 0; // GPU só dos desenhos x vaga inteira, das vagas com apresentação
+uint32_t g_gpu_frames = 0;
+// Orçamento da geração de quadros: GPU de cada quadro real (todas as vagas até a apresentação) e só da geração,
+// em médias móveis. Com o jogo + a geração acima de um quadro de 30 FPS o VSync caía para 20; aí a geração pausa.
+uint64_t g_fgb_acc = 0;
+double g_fgb_tot = 0, g_fgb_fg = 0;
+uint32_t g_fgb_n = 0;
+uint64_t g_fgb_hold = 0; // tick até quando a geração fica pausada
+uint32_t g_si = 0;           // vaga atual
+uint32_t g_ring_off = 0;
+uint32_t g_ring_flushed = 0; // anel com cache da CPU: o que já foi escrito para a memória antes de enviar
+bool g_open = false;         // vaga atual recebendo comandos
+bool g_up_any = false;       // envios de textura na lista de envio
+DkCmdBuf g_cmd = nullptr, g_up = nullptr;
+
+// Diagnóstico de GPU por desenho (dk_gpu_diag=1 no vitart_options.ini): numa a cada kDiagEvery vagas, carimbo antes e
+// depois de cada desenho; agrega por alvo e por par de shaders e loga o ranking a cada kDiagFrames vagas amostradas.
+bool g_diag = false;
+constexpr uint32_t kDiagTs = 8192, kDiagEvery = 4, kDiagFrames = 30;
+struct DiagRec { uint64_t vs, fs; uint32_t tgt, ic, flags; };
+std::vector<DiagRec> g_drec[kSlots];
+DkMemBlock g_dts[kSlots] = {};
+bool g_dcap[kSlots] = {};
+uint32_t g_dcount = 0;
+std::unordered_map<const DkShader *, uint64_t> g_sh_hash;
+struct DAcc { uint64_t ns = 0, tris = 0; uint32_t n = 0, flags = 0, maxtex = 0; };
+struct DKey {
+    uint32_t tgt; uint64_t vs, fs;
+    bool operator<(const DKey &o) const { return tgt != o.tgt ? tgt < o.tgt : vs != o.vs ? vs < o.vs : fs < o.fs; }
+};
+std::map<DKey, DAcc> g_dacc;
+std::map<uint32_t, std::pair<uint64_t, uint64_t>> g_dtgt; // alvo -> (ns dos desenhos, ns entre desenhos)
+uint64_t g_d_draw = 0, g_d_gap = 0, g_d_tris = 0, g_d_slot_ns = 0;
+uint32_t g_d_frames = 0, g_d_draws = 0;
+// para o gargalo (todas as vagas com apresentação, não só as amostradas)
+uint64_t g_d_wait = 0, g_d_gpu = 0, g_d_t0 = 0;
+uint32_t g_d_all = 0;
+
+void add_mem(void *which, DkCmdBuf cb, size_t min_req) {
+    // A memória própria da vaga entra inteira no slot_begin; aqui só chega o que passar dela (liberado quando a vaga
+    // volta).
+    Slot &s = g_slots[g_si];
+    const uint32_t sz = std::max<uint32_t>(kCmdChunk * 4, ((uint32_t)min_req + 0xFFFF) & ~0xFFFFu);
+    DKT("memória de comandos extra (%s) %u KB, pedido %u", which ? "envio" : "desenho", sz >> 10, (unsigned)min_req);
+    DkMemBlock mb = mem_block(sz, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+    s.extra.push_back(mb);
+    dkCmdBufAddMemory(cb, mb, 0, sz);
+}
+
+// Estado já gravado na lista atual (evita repetir binds iguais).
+struct Bound {
+    bool valid = false;
+    const void *target = nullptr;
+    const DkShader *vs = nullptr, *fs = nullptr;
+    uint32_t cs = 0, cw = 0;
+    DkBlendState bs{};
+    DkDepthStencilState ds{};
+    uint8_t sten[6] = {};
+    DkViewport vp{};
+    int flip = -1; // swizzle da viewport: bit0 = Y negado, bit1 = X negado
+    DkResHandle tex[16] = {};
+    bool tex_ok = false;
+    DkVtxAttribState va[32] = {};
+    DkVtxBufferState vbs[16] = {};
+    uint32_t nloc = UINT32_MAX, na = UINT32_MAX;
+};
+Bound g_b;
+
+void list_start() {
+    // A CPU escreveu no anel, nos descritores e no código sem passar pelo L2 da GPU: invalida tudo no começo da lista.
+    dkCmdBufBarrier(g_cmd, DkBarrier_None,
+                    DkInvalidateFlags_Image | DkInvalidateFlags_Shader | DkInvalidateFlags_Descriptors | DkInvalidateFlags_L2Cache);
+    if (g_tile) {
+        dkCmdBufSetTileSize(g_cmd, g_tile, g_tile);
+        dkCmdBufTiledCacheOp(g_cmd, DkTiledCacheOp_Enable);
+    }
+    dkCmdBufBindImageDescriptorSet(g_cmd, g_img_desc_gpu, kMaxImgDesc);
+    dkCmdBufBindSamplerDescriptorSet(g_cmd, g_smp_desc_gpu, kMaxSmpDesc);
+    DkRasterizerState rs;
+    dkRasterizerStateDefaults(&rs);
+    rs.cullMode = DkFace_None;
+    rs.frontFace = DkFrontFace_CW;
+    dkCmdBufBindRasterizerState(g_cmd, &rs);
+    g_b = Bound{};
+}
+
+void barrier(DkBarrier b, uint32_t inv) {
+    if (g_tile) dkCmdBufTiledCacheOp(g_cmd, DkTiledCacheOp_Flush);
+    dkCmdBufBarrier(g_cmd, b, inv);
+}
+void mark(uint32_t key) {
+    if (!g_open) return;
+    uint32_t &n = g_nmarks[g_si];
+    if (n >= kMarks) return;
+    g_mark_key[g_si][n] = key;
+    dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_slots[g_si].ts) + 48 + 16 * n);
+    n++;
+}
+
+void diag_report() {
+    const uint64_t now = now_ns();
+    const double wall = g_d_t0 && g_d_all ? (now - g_d_t0) / 1e6 / g_d_all : 0;
+    const double F = g_d_frames ? g_d_frames : 1, A = g_d_all ? g_d_all : 1;
+    const double gpu = g_d_gpu / 1e6 / A, wait = g_d_wait / 1e6 / A;
+    vt::logf("diag: ===== %u quadros amostrados (de %u) =====", g_d_frames, g_d_all);
+    vt::logf("diag: vaga %.1f ms; GPU ocupada %.1f ms (%.0f%%); CPU esperando a GPU %.1f ms -> gargalo: %s", wall, gpu,
+             wall > 0 ? 100.0 * gpu / wall : 0.0, wait,
+             wall > 0 && gpu > 0.85 * wall ? "GPU" : wait > 0.25 * wall ? "GPU (CPU parada esperando)" : "CPU / ritmo do jogo");
+    vt::logf("diag: por quadro: %.0f desenhos, %.0f mil triangulos, desenhos %.2f ms, entre desenhos (limpar/copiar/trocar "
+             "alvo) %.2f ms, vaga inteira %.2f ms (com carimbos)",
+             g_d_draws / F, g_d_tris / 3e3 / F, g_d_draw / 1e6 / F, g_d_gap / 1e6 / F, g_d_slot_ns / 1e6 / F);
+    for (auto &kv : g_dtgt)
+        vt::logf("diag: alvo %ux%u: desenhos %.2f ms, entre desenhos %.2f ms", kv.first >> 16, kv.first & 0xffff,
+                 kv.second.first / 1e6 / F, kv.second.second / 1e6 / F);
+    std::vector<std::pair<uint64_t, const std::pair<const DKey, DAcc> *>> v;
+    for (auto &kv : g_dacc) v.push_back({kv.second.ns, &kv});
+    std::sort(v.begin(), v.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+    for (size_t i = 0; i < v.size() && i < 25; i++) {
+        const DKey &k = v[i].second->first;
+        const DAcc &a = v[i].second->second;
+        vt::logf("diag: #%-2u %5.2f ms %4.1f%% | %4.0f desenhos %6.1fk tri | %ux%u vs %016llx fs %016llx |%s%s%s tex %u",
+                 (unsigned)i + 1, a.ns / 1e6 / F, g_d_draw ? 100.0 * a.ns / g_d_draw : 0.0, a.n / F, a.tris / 3e3 / F,
+                 k.tgt >> 16, k.tgt & 0xffff, (unsigned long long)k.vs, (unsigned long long)k.fs, a.flags & 1 ? " blend" : "",
+                 a.flags & 2 ? " zwrite" : "", a.flags & 4 ? " pbr" : "", a.maxtex);
+    }
+    g_dacc.clear(), g_dtgt.clear();
+    g_d_draw = g_d_gap = g_d_tris = g_d_slot_ns = 0, g_d_frames = g_d_draws = 0;
+    g_d_wait = g_d_gpu = 0, g_d_all = 0, g_d_t0 = now;
+}
+
+void diag_collect(Slot &s, const uint64_t *ts) {
+    if (s.mid) {
+        if (!g_d_t0) g_d_t0 = now_ns(), g_d_wait = 0;
+        else g_d_all++, g_d_gpu += ts[3] > ts[1] ? dkTimestampToNs(ts[3] - ts[1]) : 0;
+    }
+    const uint32_t si = (uint32_t)(&s - g_slots);
+    if (!g_dcap[si] || !s.mid || g_drec[si].empty()) return;
+    const uint64_t *d = static_cast<const uint64_t *>(dkMemBlockGetCpuAddr(g_dts[si]));
+    uint64_t prev = ts[1];
+    for (size_t i = 0; i < g_drec[si].size(); i++) {
+        const DiagRec &r = g_drec[si][i];
+        const uint64_t b = d[4 * i + 1], e = d[4 * i + 3];
+        if (b < prev || e < b) { prev = std::max(prev, e); continue; }
+        const uint64_t dn = dkTimestampToNs(e - b), gn = dkTimestampToNs(b - prev);
+        DAcc &a = g_dacc[DKey{r.tgt, r.vs, r.fs}];
+        a.ns += dn, a.n++, a.tris += r.ic, a.flags |= r.flags & 0xff, a.maxtex = std::max(a.maxtex, r.flags >> 8);
+        auto &t = g_dtgt[r.tgt];
+        t.first += dn, t.second += gn;
+        g_d_draw += dn, g_d_gap += gn, g_d_tris += r.ic, g_d_draws++;
+        prev = e;
+    }
+    if (ts[5] > ts[1]) g_d_slot_ns += dkTimestampToNs(ts[5] - ts[1]);
+    if (++g_d_frames >= kDiagFrames) diag_report();
+}
+
+void cq_sync();
+bool slot_begin() {
+    if (g_open) return true;
+    Slot &s = g_slots[g_si];
+    if (s.pending) {
+        {
+            Timer t(g_stats.wait_ns), t2(g_d_wait);
+            dkFenceWait(&s.fence, -1);
+        }
+        s.pending = false;
+        // tempo de GPU da vaga (carimbos no começo e no fim)
+        const uint64_t *ts = static_cast<const uint64_t *>(dkMemBlockGetCpuAddr(s.ts));
+        // a espera da imagem da swapchain (vsync) fica na fila entre os carimbos: não é trabalho da GPU
+        uint64_t wait_ns = 0;
+        for (uint32_t p = 0; p < 2; p++)
+            if (s.waits & (1u << p)) {
+                const uint64_t a = ts[kWaitTs / 8 + 4 * p + 1], b = ts[kWaitTs / 8 + 4 * p + 3];
+                if (b > a) wait_ns += dkTimestampToNs(b - a);
+            }
+        s.waits = 0;
+        if (ts[3] > ts[1]) {
+            const uint64_t all = dkTimestampToNs(ts[3] - ts[1]);
+            g_stats.gpu_ns += all, g_fgb_acc += all > wait_ns ? all - wait_ns : 0;
+        }
+        if (s.mid && ts[5] >= ts[1] && ts[3] >= ts[5]) {
+            uint64_t prev = ts[1], fg_ns = 0;
+            uint32_t key = 0;
+            for (uint32_t i = 0; i <= g_nmarks[g_si]; i++) {
+                const uint64_t t = i < g_nmarks[g_si] ? ts[7 + 2 * i] : ts[5];
+                if (t >= prev) {
+                    PassAcc &a = g_pass[key];
+                    a.ns += dkTimestampToNs(t - prev), a.n++;
+                    if (key == 2) fg_ns += dkTimestampToNs(t - prev);
+                }
+                if (i < g_nmarks[g_si]) prev = t, key = g_mark_key[g_si][i];
+            }
+            const double tot = g_fgb_acc / 1e6, fgm = fg_ns / 1e6;
+            g_fgb_acc = 0;
+            if (tot > 0 && tot < 200) g_fgb_tot = g_fgb_n++ ? g_fgb_tot * 0.9 + tot * 0.1 : tot;
+            if (fgm > 0) g_fgb_fg = g_fgb_fg > 0 ? g_fgb_fg * 0.9 + fgm * 0.1 : fgm;
+            g_gpu_draw_ns += dkTimestampToNs(ts[5] - ts[1]), g_gpu_all_ns += dkTimestampToNs(ts[3] - ts[1]);
+            if (++g_gpu_frames == 120) {
+                vt::logf("dk: GPU por quadro (média de 120): desenhos %.1f ms, com apresentação %.1f ms",
+                         g_gpu_draw_ns / 120e6, g_gpu_all_ns / 120e6);
+                std::vector<std::pair<uint64_t, uint32_t>> v;
+                for (auto &kv : g_pass) v.push_back({kv.second.ns, kv.first});
+                std::sort(v.rbegin(), v.rend());
+                char buf[512];
+                int o = 0;
+                for (size_t i = 0; i < v.size() && i < 8 && o < 400; i++) {
+                    const uint32_t k = v[i].second;
+                    const PassAcc &a = g_pass[k];
+                    if (k == 0) o += snprintf(buf + o, sizeof buf - o, " início %.2f ms;", a.ns / 120e6);
+                    else if (k == 1) o += snprintf(buf + o, sizeof buf - o, " cópias %.2f ms (%.1fx);", a.ns / 120e6, a.n / 120.0);
+                    else if (k == 2) o += snprintf(buf + o, sizeof buf - o, " geração de quadros %.2f ms (%.1fx);", a.ns / 120e6, a.n / 120.0);
+                    else o += snprintf(buf + o, sizeof buf - o, " %ux%u %.2f ms (%.1fx);", k >> 16, k & 0xffff, a.ns / 120e6, a.n / 120.0);
+                }
+                vt::logf("dk: GPU por alvo:%s (ladrilhos %u, profundidade %s)", buf, g_tile, g_z24 ? "Z24S8" : "Z32S8");
+                g_pass.clear();
+                g_gpu_draw_ns = g_gpu_all_ns = 0, g_gpu_frames = 0;
+            }
+        }
+        if (g_diag) diag_collect(s, ts);
+        s.mid = false;
+    }
+    g_nmarks[g_si] = 0;
+    if (g_diag) {
+        g_dcap[g_si] = g_dts[g_si] && (g_dcount++ % kDiagEvery) == 0;
+        g_drec[g_si].clear();
+    }
+    for (DkMemBlock mb : s.extra) dkMemBlockDestroy(mb);
+    s.extra.clear();
+    g_ring_off = 0, g_ring_flushed = 0;
+    // O Clear só volta o ponteiro para o começo do pedaço atual, que pode ser de uma vaga que a GPU ainda lê: entrega
+    // a memória desta vaga explicitamente.
+    dkCmdBufClear(g_cmd);
+    dkCmdBufClear(g_up);
+    dkCmdBufAddMemory(g_cmd, s.cmd, 0, kCmdMem);
+    dkCmdBufAddMemory(g_up, s.up, 0, kCmdChunk * 4);
+    s.cmd_used = kCmdMem, s.up_used = kCmdChunk * 4;
+    g_up_any = false;
+    g_open = true;
+    list_start();
+    dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(s.ts));
+    return true;
+}
+
+// Envia o que já foi gravado (envios de textura antes dos desenhos) sem fechar a vaga.
+void submit() {
+    if (!g_open) return;
+    cq_sync(); // o anel precisa das cópias do guest antes de descarregar o cache
+    if (g_ring_off > g_ring_flushed) {
+        dkMemBlockFlushCpuCache(g_slots[g_si].ring, g_ring_flushed, g_ring_off - g_ring_flushed);
+        g_ring_flushed = g_ring_off;
+    }
+    if (g_up_any) {
+        dkCmdBufBarrier(g_up, DkBarrier_Full, DkInvalidateFlags_Image | DkInvalidateFlags_L2Cache);
+        dkQueueSubmitCommands(g_queue, dkCmdBufFinishList(g_up));
+        g_up_any = false;
+    }
+    dkQueueSubmitCommands(g_queue, dkCmdBufFinishList(g_cmd));
+    g_stats.submits++;
+    list_start();
+}
+
+// Fecha a vaga: envia, sinaliza a fence e passa para a outra (que espera a GPU no próximo slot_begin).
+void slot_end() {
+    if (!g_open) return;
+    DKT("fecha vaga %u (anel %u KB, comandos %u KB, envio %u KB, extras %u)", g_si, g_ring_off >> 10,
+        g_slots[g_si].cmd_used >> 10, g_slots[g_si].up_used >> 10, (unsigned)g_slots[g_si].extra.size());
+    Slot &s = g_slots[g_si];
+    dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(s.ts) + 16);
+    submit();
+    dkQueueSignalFence(g_queue, &s.fence, true);
+    dkQueueFlush(g_queue);
+    s.pending = true;
+    g_open = false;
+    g_si = (g_si + 1) % kSlots;
+}
+
+// Garante bytes no anel da vaga atual (senão fecha a vaga e abre a outra).
+bool reserve(uint32_t need) {
+    if (need > kRing) return fail("desenho maior que o anel");
+    if (!slot_begin()) return false;
+    if (g_ring_off + need > kRing) {
+        slot_end();
+        if (!slot_begin()) return false;
+    }
+    return true;
+}
+uint32_t ring_put(const void *src, uint32_t size, uint32_t align) {
+    g_ring_off = (g_ring_off + align - 1) & ~(align - 1);
+    const uint32_t o = g_ring_off;
+    if (src && size) upload_copy(g_slots[g_si].ring_cpu + o, src, size);
+    g_ring_off += size;
+    return o;
+}
+
+// ---------------------------------------------------------------- cópias do guest em outra thread
+// Como no Vulkan: vértices, índices e uniforms que estão na memória do guest (estáveis até a GPU do Vita terminar o
+// quadro) só reservam espaço no anel; uma thread no núcleo 2 faz o memcpy enquanto o jogo segue. O envio (submit)
+// espera a fila esvaziar antes de descarregar o cache e mandar a lista. VITART_DK_ASYNC=0 copia na hora.
+struct CopyJob {
+    uint8_t *dst;
+    const void *src;
+    uint32_t n;
+};
+constexpr uint32_t kCopyCap = 16384;
+CopyJob *g_cq = nullptr;
+bool g_cq_on = false;
+std::atomic<uint32_t> g_cq_head{0}, g_cq_tail{0};
+std::atomic<bool> g_cq_sleep{false};
+std::mutex g_cq_m;
+std::condition_variable g_cq_cv;
+std::atomic<uint64_t> g_cq_rec_ns{0}; // tempo da thread copiando
+
+void cq_worker() {
+    uint32_t t = g_cq_tail.load();
+    for (;;) {
+        uint32_t h = g_cq_head.load(std::memory_order_acquire);
+        if (h == t) {
+            // fila vazia: espera ativa curta (o próximo desenho chega em dezenas de µs), depois dorme
+            const uint64_t until = armGetSystemTick() + armNsToTicks(60000);
+            while ((h = g_cq_head.load(std::memory_order_acquire)) == t && armGetSystemTick() < until) {
+            }
+            if (h == t) {
+                std::unique_lock<std::mutex> lk(g_cq_m);
+                g_cq_sleep.store(true);
+                while ((h = g_cq_head.load()) == t) g_cq_cv.wait(lk);
+                g_cq_sleep.store(false);
+            }
+        }
+        const uint64_t t0 = armGetSystemTick();
+        while (t != h) {
+            const CopyJob &j = g_cq[t % kCopyCap];
+            upload_copy(j.dst, j.src, j.n);
+            g_cq_tail.store(++t, std::memory_order_release);
+            if (t == h) h = g_cq_head.load(std::memory_order_acquire);
+        }
+        g_cq_rec_ns += armTicksToNs(armGetSystemTick() - t0);
+    }
+}
+void cq_wake() {
+    if (!g_cq_sleep.load()) return;
+    std::lock_guard<std::mutex> lk(g_cq_m);
+    g_cq_cv.notify_one();
+}
+// Espera a thread de cópia terminar tudo o que já foi pedido.
+void cq_sync() {
+    if (!g_cq_on) return;
+    const uint32_t h = g_cq_head.load(std::memory_order_relaxed);
+    if (g_cq_tail.load(std::memory_order_acquire) == h) return;
+    Timer t(g_stats.sync_ns);
+    cq_wake();
+    while (g_cq_tail.load(std::memory_order_acquire) != h) {
+        cq_wake();
+        svcSleepThread(0); // cede o núcleo (a cópia roda em outro)
+    }
+}
+void cq_start() {
+    const char *e = getenv("VITART_DK_ASYNC");
+    if (e && *e == '0') {
+        vt::logf("dk: cópias do guest na thread do jogo (VITART_DK_ASYNC=0)");
+        return;
+    }
+    g_cq = new CopyJob[kCopyCap];
+    g_cq_on = true;
+    vt::spawn_detached(cq_worker, "copia dk");
+    vt::logf("dk: cópias do guest em thread separada");
+}
+// Como ring_put, mas com dado do guest: só reserva, e a cópia vai para a fila (pequenas copiam na hora).
+uint32_t ring_put_g(const void *src, uint32_t size, uint32_t align, bool guest) {
+    if (!guest || !g_cq_on || !src || size < 256) return ring_put(src, size, align);
+    g_ring_off = (g_ring_off + align - 1) & ~(align - 1);
+    const uint32_t o = g_ring_off;
+    const uint32_t h = g_cq_head.load(std::memory_order_relaxed);
+    if (h - g_cq_tail.load(std::memory_order_acquire) >= kCopyCap) cq_sync();
+    g_cq[h % kCopyCap] = {g_slots[g_si].ring_cpu + o, src, size};
+    g_cq_head.store(h + 1, std::memory_order_release);
+    if (g_cq_sleep.load() && h + 1 - g_cq_tail.load(std::memory_order_relaxed) >= 4) cq_wake();
+    g_ring_off += size;
+    return o;
+}
+DkGpuAddr ring_gpu(uint32_t off) { return g_slots[g_si].ring_gpu + off; }
+
+// ---------------------------------------------------------------- shaders (shaders_dk.pak)
+struct PakEnt {
+    uint64_t key;
+    uint32_t off, size;
+};
+std::FILE *g_pak = nullptr;
+std::vector<PakEnt> g_pak_idx;
+DkMemBlock g_code = nullptr;
+uint32_t g_code_off = 0;
+constexpr uint32_t kCode = 48u << 20;
+struct ShaderRef {
+    const uint32_t *code = nullptr;
+    uint32_t size = 0;
+    uint32_t head[8] = {}; // primeiros 32 bytes do código: confere ponteiro reaproveitado sem hash
+    DkShader *sh = nullptr;
+};
+std::unordered_map<const uint32_t *, ShaderRef> g_by_ptr;
+std::unordered_map<uint64_t, DkShader *> g_by_key;
+
+bool pak_open() {
+    const char *d = getenv("VITART_SPV_DIR");
+    const std::string path = std::string(d ? d : "spv") + "/shaders_dk.pak";
+    g_pak = std::fopen(path.c_str(), "rb");
+    if (!g_pak) return fail("shaders_dk.pak não encontrado (tools/pack_shaders_dk.py)");
+    char magic[8];
+    uint32_t n = 0, rsv = 0;
+    if (std::fread(magic, 1, 8, g_pak) != 8 || std::memcmp(magic, "DKSPAK1", 8) || std::fread(&n, 4, 1, g_pak) != 1 ||
+        std::fread(&rsv, 4, 1, g_pak) != 1)
+        return fail("shaders_dk.pak inválido");
+    g_pak_idx.resize(n);
+    if (std::fread(g_pak_idx.data(), sizeof(PakEnt), n, g_pak) != n) return fail("shaders_dk.pak truncado");
+    vt::logf("dk: pacote de shaders: %u programas", n);
+    return true;
+}
+
+DkShader *shader_load(uint64_t key) {
+    auto it = g_by_key.find(key);
+    if (it != g_by_key.end()) return it->second;
+    DkShader *res = nullptr;
+    auto e = std::lower_bound(g_pak_idx.begin(), g_pak_idx.end(), key, [](const PakEnt &a, uint64_t k) { return a.key < k; });
+    if (e != g_pak_idx.end() && e->key == key && e->size >= 24) {
+        std::vector<uint8_t> buf(e->size);
+        if (!std::fseek(g_pak, (long)e->off, SEEK_SET) && std::fread(buf.data(), 1, buf.size(), g_pak) == buf.size()) {
+            uint32_t hdr[6];
+            std::memcpy(hdr, buf.data(), sizeof hdr); // magic, header_sz, control_sz, code_sz, programs_off, num_programs
+            const uint32_t csz = hdr[2], code_sz = hdr[3];
+            if (hdr[0] == 0x48534B44 && csz + code_sz <= buf.size() &&
+                g_code_off + code_sz + DK_SHADER_CODE_UNUSABLE_SIZE <= kCode) {
+                std::memcpy(static_cast<uint8_t *>(dkMemBlockGetCpuAddr(g_code)) + g_code_off, buf.data() + csz, code_sz);
+                DkShaderMaker sm;
+                dkShaderMakerDefaults(&sm, g_code, g_code_off);
+                sm.control = buf.data();
+                sm.programId = 0;
+                res = new DkShader;
+                dkShaderInitialize(res, &sm);
+                g_code_off = (g_code_off + code_sz + DK_SHADER_CODE_ALIGNMENT - 1) & ~(DK_SHADER_CODE_ALIGNMENT - 1);
+            }
+        }
+    }
+    DKT("shader %016llx -> %p (código em %u)", (unsigned long long)key, (void *)res, g_code_off);
+    if (!res) vt::logf("dk: shader %016llx ausente no shaders_dk.pak", (unsigned long long)key);
+    return g_by_key[key] = res;
+}
+
+DkShader *shader_for(const uint32_t *code, uint32_t size) {
+    // O código vem do hle_gxm (vivo enquanto o programa existe); o ponteiro é a chave rápida, conferida pelo tamanho
+    // e pelos primeiros 32 bytes (um ponteiro reaproveitado por outro programa refaz o hash inteiro). Um cache de
+    // 4 entradas na frente evita o unordered_map nos draws seguidos com os mesmos programas.
+    static ShaderRef *recent[4] = {};
+    static unsigned rr = 0;
+    const uint32_t hn = std::min<uint32_t>(size, 32);
+    for (ShaderRef *r : recent)
+        if (r && r->code == code && r->size == size && !std::memcmp(r->head, code, hn)) return r->sh;
+    ShaderRef &r = g_by_ptr[code];
+    recent[rr++ & 3] = &r;
+    if (r.code == code && r.size == size && !std::memcmp(r.head, code, hn)) return r.sh;
+    r.code = code, r.size = size;
+    std::memset(r.head, 0, sizeof r.head);
+    std::memcpy(r.head, code, hn);
+    r.sh = shader_load(fnv(code, size));
+    return r.sh;
+}
+
+// ---------------------------------------------------------------- alvos
+constexpr DkImageFormat kColor = DkImageFormat_RGBA8_Unorm;
+DkImageFormat kDepth = DkImageFormat_Z24S8;
+float g_scale = 1.f;
+uint32_t scaled(uint32_t g, float s) {
+    const uint32_t v = (uint32_t)(g * s + 0.5f);
+    return v ? v : 1;
+}
+struct Target {
+    Img color, depth, snap;
+    uint32_t gw = 0, gh = 0;
+    uint64_t cena = 0, snap_cena = UINT64_MAX;
+    bool le_a_si = false;
+};
+std::map<uint32_t, Target> g_targets;
+std::map<uint32_t, uint32_t> g_depth_owner;
+
+void bind_target(Target &t) {
+    if (g_b.target == &t) return;
+    // o que foi desenhado no alvo anterior pode ser lido como textura daqui em diante
+    if (g_b.target) barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    DkImageView cv, dv;
+    dkImageViewDefaults(&cv, &t.color.im);
+    dkImageViewDefaults(&dv, &t.depth.im);
+    const DkImageView *cvs[1] = {&cv};
+    dkCmdBufBindRenderTarget(g_cmd, cvs[0], &dv);
+    const DkScissor sc{0, 0, t.color.w, t.color.h};
+    dkCmdBufSetScissors(g_cmd, 0, &sc, 1);
+    g_b.target = &t;
+    g_cur_key = t.color.w << 16 | t.color.h;
+    mark(g_cur_key);
+}
+
+bool get_target(uint32_t addr, uint32_t gw, uint32_t gh, Target *&out) {
+    auto it = g_targets.find(addr);
+    if (it != g_targets.end()) {
+        out = &it->second;
+        return true;
+    }
+    DKT("alvo novo %08x %ux%u", addr, gw, gh);
+    Target &t = g_targets[addr];
+    t.gw = gw, t.gh = gh;
+    const uint32_t w = scaled(gw, g_scale), h = scaled(gh, g_scale);
+    Timer tm(g_stats.alloc_ns);
+    // compressão de hardware nos alvos: menos banda de memória em cor e profundidade (a GPU descomprime sozinha nas
+    // leituras como textura e nas cópias do motor 2D)
+    if (!img_make(t.color, w, h, kColor, DkImageFlags_UsageRender | DkImageFlags_Usage2DEngine | DkImageFlags_HwCompression) ||
+        !img_make(t.depth, w, h, kDepth, DkImageFlags_UsageRender | DkImageFlags_HwCompression)) {
+        g_targets.erase(addr);
+        return false;
+    }
+    // estado inicial: cor 0, profundidade 1 (o jogo limpa com desenhos próprios)
+    bind_target(t);
+    dkCmdBufClearColorFloat(g_cmd, 0, DkColorMask_RGBA, 0, 0, 0, 0);
+    dkCmdBufClearDepthStencil(g_cmd, true, 1.0f, 0xFF, 0);
+    out = &t;
+    return true;
+}
+
+// Cópia de um alvo de cor para outra imagem (motor 2D), fora da ordem dos fragmentos.
+void copy_color(Img &src, Img &dst) {
+    DKT("  cópia de alvo %ux%u", src.w, src.h);
+    barrier(DkBarrier_Full, 0);
+    DkImageView sv, dv;
+    dkImageViewDefaults(&sv, &src.im);
+    dkImageViewDefaults(&dv, &dst.im);
+    const DkImageRect r{0, 0, 0, src.w, src.h, 1};
+    mark(1);
+    dkCmdBufCopyImage(g_cmd, &sv, &r, &dv, &r, 0);
+    barrier(DkBarrier_Full, DkInvalidateFlags_Image); // o motor 2D escreve pelo L2: só as texturas
+    if (g_b.target) mark(g_cur_key);
+    g_stats.snapshots++;
+}
+// Mesma cópia pelo 3D: triângulo de tela cheia com texelFetch. O motor 2D faz ~2 pixels por ciclo (0,9 ms por
+// cópia de 1271x720 a 307 MHz); o 3D escreve pelos ROPs com compressão. dk_blit3d=0 no ini volta ao motor 2D.
+DkShader *g_blit_vs = nullptr, *g_blit_fs = nullptr;
+bool g_blit3d = true;
+DkShader *shader_from_dksh(const uint8_t *buf, size_t n) {
+    uint32_t hdr[6];
+    if (n < sizeof hdr) return nullptr;
+    std::memcpy(hdr, buf, sizeof hdr);
+    const uint32_t csz = hdr[2], code_sz = hdr[3];
+    if (hdr[0] != 0x48534B44 || csz + code_sz > n || g_code_off + code_sz + DK_SHADER_CODE_UNUSABLE_SIZE > kCode) return nullptr;
+    std::memcpy(static_cast<uint8_t *>(dkMemBlockGetCpuAddr(g_code)) + g_code_off, buf + csz, code_sz);
+    DkShaderMaker sm;
+    dkShaderMakerDefaults(&sm, g_code, g_code_off);
+    sm.control = buf;
+    sm.programId = 0;
+    DkShader *res = new DkShader;
+    dkShaderInitialize(res, &sm);
+    g_code_off = (g_code_off + code_sz + DK_SHADER_CODE_ALIGNMENT - 1) & ~(DK_SHADER_CODE_ALIGNMENT - 1);
+    return res;
+}
+void blit_color(Img &src, Img &dst) {
+    DKT("  cópia 3D de alvo %ux%u", src.w, src.h);
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    mark(1);
+    DkCmdBuf c = g_cmd;
+    DkImageView dv;
+    dkImageViewDefaults(&dv, &dst.im);
+    dkCmdBufBindRenderTarget(c, &dv, nullptr);
+    const DkViewport vp{0, 0, (float)dst.w, (float)dst.h, 0, 1};
+    dkCmdBufSetViewports(c, 0, &vp, 1);
+    const DkViewportSwizzle sw{DkSwizzle_PositiveX, DkSwizzle_PositiveY, DkSwizzle_PositiveZ, DkSwizzle_PositiveW};
+    dkCmdBufSetViewportSwizzles(c, 0, &sw, 1);
+    const DkScissor sc{0, 0, dst.w, dst.h};
+    dkCmdBufSetScissors(c, 0, &sc, 1);
+    const DkShader *sh[2] = {g_blit_vs, g_blit_fs};
+    dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, sh, 2);
+    DkColorState cs;
+    dkColorStateDefaults(&cs);
+    dkColorStateSetBlendEnable(&cs, 0, false);
+    dkCmdBufBindColorState(c, &cs);
+    DkColorWriteState cw;
+    dkColorWriteStateDefaults(&cw);
+    dkColorWriteStateSetMask(&cw, 0, DkColorMask_RGBA);
+    dkCmdBufBindColorWriteState(c, &cw);
+    DkDepthStencilState ds;
+    dkDepthStencilStateDefaults(&ds);
+    ds.depthTestEnable = 0, ds.depthWriteEnable = 0, ds.stencilTestEnable = 0;
+    dkCmdBufBindDepthStencilState(c, &ds);
+    const DkResHandle h = dkMakeTextureHandle(src.desc, 0);
+    dkCmdBufBindTextures(c, DkStage_Fragment, 0, &h, 1);
+    dkCmdBufBindVtxAttribState(c, nullptr, 0);
+    dkCmdBufBindVtxBufferState(c, nullptr, 0);
+    dkCmdBufDraw(c, DkPrimitive_Triangles, 3, 1, 0, 0);
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    g_b = Bound{}; // estado todo regravado no próximo desenho (e o alvo religado por bind_target)
+    g_stats.snapshots++;
+}
+
+// ---------------------------------------------------------------- pós-processamento na apresentação
+// Opções gráficas (set_gfx): FXAA na resolução interna, ampliação bilinear ou FSR 1.0 (EASU), nitidez RCAS, cor (brilho,
+// saturação, vibrance) e dither, em passes 3D até a imagem da tela. Com tudo no padrão fica a cópia do motor 2D de
+// sempre (custo zero). Shaders em tools/dk_post (uam -> dk_post_shaders.h); o de vértice é o triângulo do blit.
+DkShader *g_fxaa_fs = nullptr, *g_easu_fs = nullptr, *g_post_fs = nullptr, *g_nv12_fs = nullptr;
+// valores na ordem dos kGfx* (gxm_api.inc); brilho e saturação 4 = neutro
+std::atomic<uint32_t> g_gfx[kGfxCount] = {0, 0, 0, 1, 4, 4, 0, 0};
+Img g_aa, g_easu; // saída do FXAA (tamanho da fonte) e do EASU (tamanho do retângulo na tela)
+// diagnóstico do FSR (tela preta): ao ligar, lê a fonte, a saída do EASU e a tela de uma apresentação e grava no log
+std::atomic<int> g_fsr_diag{0};
+const Img *g_fsr_src = nullptr;
+char g_fsr_info[160];
+const Img *g_fsr_cur = nullptr;
+uint32_t g_fsr_smp = 0;
+float g_fsr_ub[12];
+bool post_on() {
+    if (!g_blit_vs || !g_post_fs) return false;
+    return g_gfx[kGfxAA] || g_gfx[kGfxUpscale] || g_gfx[kGfxSharp] || g_gfx[kGfxGamma] != 4 || g_gfx[kGfxSat] != 4 ||
+           g_gfx[kGfxVibrance] || g_gfx[kGfxDither];
+}
+bool post_img(Img &im, uint32_t w, uint32_t h) {
+    if (im.ok && im.w == w && im.h == h) return true;
+    img_free(im);
+    if (!img_make(im, w, h, kColor, DkImageFlags_UsageRender | DkImageFlags_Usage2DEngine)) return false;
+    dkCmdBufBarrier(g_cmd, DkBarrier_None, DkInvalidateFlags_Descriptors);
+    return true;
+}
+// Triângulo de tela cheia no retângulo (x, y, w, h) de dv, lendo src (amostrador smp) e com o bloco de uniforms ub.
+void post_pass(const DkImageView &dv, uint32_t x, uint32_t y, uint32_t w, uint32_t h, const DkShader *fs, const Img &src,
+               uint32_t smp, const float *ub, uint32_t n_floats) {
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    DkCmdBuf c = g_cmd;
+    dkCmdBufBindRenderTarget(c, &dv, nullptr);
+    const DkViewport vp{(float)x, (float)y, (float)w, (float)h, 0, 1};
+    dkCmdBufSetViewports(c, 0, &vp, 1);
+    const DkViewportSwizzle sw{DkSwizzle_PositiveX, DkSwizzle_PositiveY, DkSwizzle_PositiveZ, DkSwizzle_PositiveW};
+    dkCmdBufSetViewportSwizzles(c, 0, &sw, 1);
+    const DkScissor sc{x, y, w, h};
+    dkCmdBufSetScissors(c, 0, &sc, 1);
+    const DkShader *sh[2] = {g_blit_vs, fs};
+    dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, sh, 2);
+    DkColorState cs;
+    dkColorStateDefaults(&cs);
+    dkColorStateSetBlendEnable(&cs, 0, false);
+    dkCmdBufBindColorState(c, &cs);
+    DkColorWriteState cw;
+    dkColorWriteStateDefaults(&cw);
+    dkColorWriteStateSetMask(&cw, 0, DkColorMask_RGBA);
+    dkCmdBufBindColorWriteState(c, &cw);
+    DkDepthStencilState ds;
+    dkDepthStencilStateDefaults(&ds);
+    ds.depthTestEnable = 0, ds.depthWriteEnable = 0, ds.stencilTestEnable = 0;
+    dkCmdBufBindDepthStencilState(c, &ds);
+    const uint32_t off = ring_put(ub, n_floats * 4, 256);
+    dkCmdBufBindUniformBuffer(c, DkStage_Fragment, 0, ring_gpu(off), (n_floats * 4 + 255) & ~255u);
+    const DkResHandle th = dkMakeTextureHandle(src.desc, smp);
+    dkCmdBufBindTextures(c, DkStage_Fragment, 0, &th, 1);
+    dkCmdBufBindVtxAttribState(c, nullptr, 0);
+    dkCmdBufBindVtxBufferState(c, nullptr, 0);
+    dkCmdBufDraw(c, DkPrimitive_Triangles, 3, 1, 0, 0);
+    g_b = Bound{};
+}
+// A imagem do jogo (área ex,ey .. w-ex,h-ey) no retângulo (dx, dy, dw, dh) da tela dv, com as opções gráficas.
+// false: algo faltou (memória), e o chamador faz a cópia do motor 2D.
+bool post_present(Img &src, uint32_t ex, uint32_t ey, const DkImageView &dv, uint32_t dx, uint32_t dy, uint32_t dw, uint32_t dh) {
+    const uint32_t lin = sampler_idx(true, true, 2, 2, false, false, 31), pnt = sampler_idx(false, false, 2, 2, false, false, 31);
+    const Img *cur = &src;
+    if (g_gfx[kGfxAA] && g_fxaa_fs) {
+        if (!post_img(g_aa, src.w, src.h)) return false;
+        DkImageView av;
+        dkImageViewDefaults(&av, &g_aa.im);
+        const float ub[4] = {1.f / src.w, 1.f / src.h, 0, 0};
+        post_pass(av, 0, 0, src.w, src.h, g_fxaa_fs, src, lin, ub, 4);
+        cur = &g_aa;
+    }
+    const float uw = src.w - 2.f * ex, uh = src.h - 2.f * ey;
+    bool full = false; // a fonte do passe final já tem o tamanho do retângulo da tela
+    // EASU só amplia: com a imagem do jogo maior que a tela (2x, 3x...) ele não ajuda e a redução fica no bilinear.
+    // Quase 1x (720p: 1269 -> 1280) também não: ele custa um passe de 12 amostras na tela toda (por apresentação, duas
+    // com a geração de quadros) para um ganho invisível; aí fica só o RCAS do passe final.
+    if (g_gfx[kGfxUpscale] && g_easu_fs && (dw > uw * 1.05f || dh > uh * 1.05f)) {
+        if (!post_img(g_easu, dw, dh)) return false;
+        DkImageView uv;
+        dkImageViewDefaults(&uv, &g_easu.im);
+        const float ub[12] = {(float)ex, (float)ey, uw, uh, (float)dw, (float)dh, 1.f / cur->w, 1.f / cur->h, 0, 0, 0, 0};
+        std::memcpy(g_fsr_ub, ub, sizeof ub), g_fsr_cur = cur, g_fsr_smp = lin;
+        post_pass(uv, 0, 0, dw, dh, g_easu_fs, *cur, lin, ub, 12); // amostra no centro do texel: linear = ponto
+        cur = &g_easu, full = true;
+    }
+    g_fsr_src = &src;
+    std::snprintf(g_fsr_info, sizeof g_fsr_info, "fonte %ux%u borda %u,%u -> %ux%u em %u,%u, easu %s, aa %u, smp lin %u pnt %u",
+                  src.w, src.h, ex, ey, dw, dh, dx, dy, full ? "sim" : "não", (unsigned)g_gfx[kGfxAA], lin, pnt);
+    // FSR 1.0 é EASU + RCAS: com o FSR ligado e a nitidez em "Off", usa a nitidez padrão da AMD (0,2 stop = nível 9).
+    // Sem isso, a 720p no portátil (1270x720 -> 1280x720) o FSR não mudava nada na imagem.
+    const uint32_t sh_v = g_gfx[kGfxSharp], sh = sh_v ? sh_v : g_gfx[kGfxUpscale] ? 9u : 0u;
+    const float k = sh ? std::exp2(-2.f * (1.f - sh / 10.f)) : 0.f; // nitidez 1..10 -> 2..0 stops do RCAS
+    const float gam = 1.f - 0.07f * ((float)g_gfx[kGfxGamma] - 4.f); // brilho: expoente < 1 clareia
+    const float sat = 0.6f + 0.1f * (float)g_gfx[kGfxSat];
+    const float vib = g_gfx[kGfxVibrance] * 0.25f;
+    const float ub[16] = {(float)dx, (float)dy, 1.f / dw, 1.f / dh,
+                          full ? 0.f : ex / (float)src.w, full ? 0.f : ey / (float)src.h, full ? 1.f : uw / src.w, full ? 1.f : uh / src.h,
+                          full ? 1.f : 0.f, k, gam, sat,
+                          vib, g_gfx[kGfxDither] ? 1.f : 0.f, 0, 0};
+    post_pass(dv, dx, dy, dw, dh, g_post_fs, *cur, lin, ub, 16);
+    barrier(DkBarrier_Fragments, 0);
+    return true;
+}
+
+bool snap_own(Target &t) {
+    if (t.snap_cena == t.cena) return true;
+    const bool b3 = g_blit3d && g_blit_vs && g_blit_fs;
+    if (!t.snap.ok &&
+        !img_make(t.snap, t.color.w, t.color.h, kColor,
+                  b3 ? DkImageFlags_UsageRender | DkImageFlags_HwCompression | DkImageFlags_Usage2DEngine : DkImageFlags_Usage2DEngine))
+        return false;
+    if (b3) blit_color(t.color, t.snap);
+    else copy_color(t.color, t.snap);
+    t.snap_cena = t.cena;
+    return true;
+}
+
+void destroy_targets() {
+    for (auto &kv : g_targets) img_free(kv.second.color), img_free(kv.second.depth), img_free(kv.second.snap);
+    g_targets.clear();
+    g_depth_owner.clear();
+    g_b = Bound{};
+}
