+static void fsr_compute_barrier() {
+    VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    mb.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    vkCmdPipelineBarrier(g_pcmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0,
+                         nullptr);
+}
+// src -> g_fsr_b (dw x dh, TRANSFER_SRC no fim); nullptr se não deu (fica no blit bilinear)
+static Image *fsr_run(Image &src, uint32_t dw, uint32_t dh) {
+    if (!src.img || src.fmt != kColor || !dw || !dh || !fsr_init()) return nullptr;
+    if (g_fsr_a.w != dw || g_fsr_a.h != dh) {
+        destroy(g_fsr_a);
+        destroy(g_fsr_b);
+        const VkImageUsageFlags u = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        if (!make_image(g_fsr_a, dw, dh, kColor, u) || !make_image(g_fsr_b, dw, dh, kColor, u)) {
+            destroy(g_fsr_a);
+            destroy(g_fsr_b);
+            return nullptr;
+        }
+    }
+    barrier(src, VK_IMAGE_LAYOUT_GENERAL);
+    barrier(g_fsr_a, VK_IMAGE_LAYOUT_GENERAL);
+    barrier(g_fsr_b, VK_IMAGE_LAYOUT_GENERAL);
+    VkDescriptorImageInfo ii[4] = {{VK_NULL_HANDLE, src.view, VK_IMAGE_LAYOUT_GENERAL},
+                                   {VK_NULL_HANDLE, g_fsr_a.view, VK_IMAGE_LAYOUT_GENERAL},
+                                   {VK_NULL_HANDLE, g_fsr_a.view, VK_IMAGE_LAYOUT_GENERAL},
+                                   {VK_NULL_HANDLE, g_fsr_b.view, VK_IMAGE_LAYOUT_GENERAL}};
+    VkWriteDescriptorSet w[4]{};
+    for (uint32_t i = 0; i < 4; i++) {
+        w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        w[i].dstSet = g_fsr_sets[i / 2];
+        w[i].dstBinding = i % 2;
+        w[i].descriptorCount = 1;
+        w[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        w[i].pImageInfo = &ii[i];
+    }
+    vkUpdateDescriptorSets(g_dev, 4, w, 0, nullptr);
+    FsrPush pc{{(int32_t)src.w, (int32_t)src.h, (int32_t)dw, (int32_t)dh}, {0, 0, 0, 0}};
+    // nitidez 0..10 -> 2..0 stops do RCAS (10 = máxima)
+    pc.k[0] = std::exp2(-2.f * (1.f - g_ups_sharp.load() / 10.f));
+    for (uint32_t i = 0; i < 2; i++) {
+        vkCmdBindPipeline(g_pcmd, VK_PIPELINE_BIND_POINT_COMPUTE, g_fsr_pipe[i]);
+        vkCmdBindDescriptorSets(g_pcmd, VK_PIPELINE_BIND_POINT_COMPUTE, g_fsr_layout, 0, 1, &g_fsr_sets[i], 0, nullptr);
