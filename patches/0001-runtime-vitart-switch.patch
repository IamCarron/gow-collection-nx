+    return true;
+}
+// Quadro NV12/P010 do NVDEC (g_vidn_*) -> g_vid (RGBA): o quadro vai para o anel e o shader nv12 lê como buffer.
+bool nv12_pass() {
+    if (!g_vidn_px || !g_vidn_w || !g_vidn_h || !g_blit_vs || !g_nv12_fs) return false;
+    const uint64_t used = (uint64_t)g_vidn_uv + (uint64_t)g_vidn_pitch * ((g_vidn_h + 1) / 2);
+    const uint32_t bytes = (uint32_t)((used + 3) & ~3ull);
+    if (bytes + g_ring_off + 4096 >= kRing || !vid_img(g_vidn_w, g_vidn_h)) return false;
+    const uint32_t off = ring_put(g_vidn_px, bytes, 256);
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    DkCmdBuf c = g_cmd;
+    DkImageView dv;
+    dkImageViewDefaults(&dv, &g_vid.im);
+    dkCmdBufBindRenderTarget(c, &dv, nullptr);
+    const DkViewport vp{0, 0, (float)g_vidn_w, (float)g_vidn_h, 0, 1};
+    dkCmdBufSetViewports(c, 0, &vp, 1);
+    const DkViewportSwizzle sw{DkSwizzle_PositiveX, DkSwizzle_PositiveY, DkSwizzle_PositiveZ, DkSwizzle_PositiveW};
+    dkCmdBufSetViewportSwizzles(c, 0, &sw, 1);
+    const DkScissor sc{0, 0, g_vidn_w, g_vidn_h};
+    dkCmdBufSetScissors(c, 0, &sc, 1);
+    const DkShader *sh[2] = {g_blit_vs, g_nv12_fs};
+    dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, sh, 2);
+    DkColorState cs;
+    dkColorStateDefaults(&cs);
+    dkColorStateSetBlendEnable(&cs, 0, false);
+    dkCmdBufBindColorState(c, &cs);
+    DkColorWriteState cw;
+    dkColorWriteStateDefaults(&cw);
+    dkColorWriteStateSetMask(&cw, 0, DkColorMask_RGBA);
+    dkCmdBufBindColorWriteState(c, &cw);
+    DkDepthStencilState ds;
+    dkDepthStencilStateDefaults(&ds);
+    ds.depthTestEnable = 0, ds.depthWriteEnable = 0, ds.stencilTestEnable = 0;
+    dkCmdBufBindDepthStencilState(c, &ds);
+    const int32_t ub[8] = {(int32_t)g_vidn_w, (int32_t)g_vidn_h, (int32_t)g_vidn_pitch, (int32_t)g_vidn_uv,
+                           (int32_t)(g_vidn_flags & 1), (int32_t)((g_vidn_flags >> 1) & 1), (int32_t)((g_vidn_flags >> 2) & 1), 0};
+    const uint32_t uo = ring_put(ub, sizeof ub, 256);
+    dkCmdBufBindUniformBuffer(c, DkStage_Fragment, 0, ring_gpu(uo), 256);
+    dkCmdBufBindStorageBuffer(c, DkStage_Fragment, 0, ring_gpu(off), bytes);
+    dkCmdBufBindVtxAttribState(c, nullptr, 0);
+    dkCmdBufBindVtxBufferState(c, nullptr, 0);
+    dkCmdBufDraw(c, DkPrimitive_Triangles, 3, 1, 0, 0);
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    g_b = Bound{};
+    static uint32_t lw = 0, lh = 0;
+    if (lw != g_vidn_w || lh != g_vidn_h) {
+        vt::logf("dk: cena remasterizada %ux%u (pitch %u, %s, %u KB por quadro)", g_vidn_w, g_vidn_h, g_vidn_pitch,
+                 g_vidn_flags & 1 ? "P010" : "NV12", bytes >> 10);
+        lw = g_vidn_w, lh = g_vidn_h;
+    }
+    return true;
+}
+
+
+std::vector<float> g_debug_vs;
+uint32_t g_dw_frame = 0, g_dw_last = 0;
+
+// ---------------------------------------------------------------- geração de quadros (LSFG, lsfg-deko3d)
+// Lossless Scaling Frame Generation pelo lsfg-deko3d (GPL-3.0-or-later, vindo do Cemu-nx). Os shaders saem do
+// Lossless.dll do usuário no PC (tools/lsfg_prep) para <raiz>/lsfg/{Performance,Quality}. Aqui só a execução: a cada
+// quadro real o alvo entra no histórico (2 imagens) e as passadas de compute geram o quadro do meio, apresentado
+// antes do real (30 -> 60). Adaptado do DKFrameGenerator.cpp do Cemu-nx (GPL-2.0-or-later).
+#ifdef VITART_LSFG
+namespace fg {
+namespace backend = lsfg::backend;
+namespace graph = lsfg::graph;
+constexpr uint32_t kDesc = sizeof(DkImageDescriptor);
+constexpr uint64_t kBudget = 128ull << 20;
+static_assert(backend::max_texture_slots <= DK_NUM_TEXTURE_BINDINGS);
+static_assert(backend::max_storage_slots <= DK_NUM_IMAGE_BINDINGS);
+
+uint32_t g_mode = 0;   // 0 desligado, 1 desempenho, 2 qualidade
+uint32_t g_loaded = 0; // modo com cache carregado (0 = nenhum)
+bool g_failed = false; // falhou neste modo: não tenta de novo até trocar
+graph::Config g_cfg;
+lsfg::cache::Loaded g_cache;
+backend::Schedule g_sched;
+DkMemBlock g_code_mb = nullptr;
+std::vector<DkShader> g_shd;
+uint32_t g_w = 0, g_h = 0;
+backend::Plan g_plan;
+backend::DescriptorLayout g_layout;
+DkMemBlock g_img_mb = nullptr, g_desc_mb = nullptr, g_uni_mb = nullptr;
+std::vector<DkImage> g_imgs;
+std::vector<bool> g_owned;
+Img g_hist[graph::history_image_count];
+std::vector<Img> g_gen;
+std::vector<uint8_t> g_haz;
+std::vector<uint32_t> g_haz_list;
+uint32_t g_frame = 0, g_since_reset = 0;
+
+bool fail_fg(const std::string &why) {
+    vt::logf("dk: geração de quadros desligada: %s", why.c_str());
+    g_failed = true;
+    return false;
+}
+void free_mb(DkMemBlock &m) {
+    if (m) dkMemBlockDestroy(m), m = nullptr;
+}
+// Fluxo óptico em 1/g_flow da resolução (fg_flow= no vitart_options.ini; padrão 2). As passadas de fluxo são a maior
+// parte do custo, e na metade a geração cabe no relógio padrão da GPU. Cada divisor tem o seu cache (Performance_f2...).
+uint32_t g_flow = 2;
+// teto do divisor nesta resolução: o fluxo de 1/4 em 720x408 some na cadeia e o plano é recusado; aí desce para
+// 1/3, 1/2... em vez de desligar a geração (volta a 4 quando a resolução ou o fluxo pedido mudam)
+uint32_t g_flow_cap = 4, g_cap_w = 0, g_cap_h = 0;
+bool g_refused = false;
+std::string cache_dir(uint32_t mode, uint32_t den) {
+    return nxp::root_dir() + (mode == 2 ? "/lsfg/Quality" : "/lsfg/Performance") + (den > 1 ? "_f" + std::to_string(den) : "");
+}
+bool cache_has(uint32_t mode, uint32_t den) {
+    std::FILE *f = std::fopen((cache_dir(mode, den) + "/manifest.bin").c_str(), "rb");
+    if (f) std::fclose(f);
+    return f != nullptr;
+}
+// o divisor pedido se o cache dele existe; senão o fluxo cheio
+uint32_t flow_for(uint32_t mode) {
+    for (uint32_t d = std::min(g_flow, g_flow_cap); d > 1; d--)
+        if (cache_has(mode, d)) return d;
+    return 1;
+}
+bool cache_present(uint32_t mode) { return cache_has(mode, flow_for(mode)); }
+
+void release_alloc() {
+    for (Img &h : g_hist) img_free(h);
+    for (Img &g : g_gen) img_free(g);
+    g_gen.clear(), g_imgs.clear(), g_owned.clear();
+    free_mb(g_img_mb), free_mb(g_desc_mb), free_mb(g_uni_mb);
+    g_w = g_h = 0;
+}
+void unload() {
+    g_fgb_fg = 0, g_fgb_n = 0, g_fgb_hold = 0; // outro fluxo ou modo: custo novo, tenta de novo
+    if (!g_loaded && !g_code_mb && !g_w) return;
+    dkQueueWaitIdle(g_queue);
+    release_alloc();
+    free_mb(g_code_mb);
+    g_shd.clear();
+    g_cache = {};
+    g_loaded = 0;
+}
+
+bool load(uint32_t mode) {
+    g_cfg = graph::Config{};
+    g_cfg.performance = mode != 2;
+    g_cfg.generated_frames = 1;
+    g_cfg.flow_numerator = 1;
+    g_cfg.flow_denominator = flow_for(mode);
+    const std::string dir = cache_dir(mode, g_cfg.flow_denominator);
+    lsfg::ErrorCode c = lsfg::cache::read(dir, g_cache);
+    if (!lsfg::succeeded(c)) return fail_fg("cache em " + dir + " (" + std::string(lsfg::error_name(c)) + "); rode tools/lsfg_prep");
+    if (!lsfg::succeeded(c = graph::build(g_cfg, g_cache.graph))) return fail_fg("grafo: " + std::string(lsfg::error_name(c)));
+    lsfg::cache::describe(g_cache.header, g_cache.graph);
+    std::vector<lsfg::cache::PassEntry> passes;
+    std::vector<lsfg::cache::SlotEntry> slots;
+    for (const auto &p : g_cache.passes) {
+        auto e = p.entry;
+        e.slot_first = (uint32_t)slots.size();
+        passes.push_back(e);
+        slots.insert(slots.end(), p.slots.begin(), p.slots.end());
+    }
+    if (!lsfg::succeeded(c = lsfg::cache::validate(g_cache.header, passes, slots, g_cache.graph)))
+        return fail_fg("cache não serve para esta configuração: " + std::string(lsfg::error_name(c)));
+    if (!lsfg::succeeded(c = backend::schedule(g_cache.graph, g_sched))) return fail_fg("agenda: " + std::string(lsfg::error_name(c)));
+    // código de todas as passadas num bloco só
+    std::vector<uint32_t> offs;
+    backend::Arena arena;
+    for (const auto &p : g_cache.passes) {
+        lsfg::dksh::FileHeader h;
+        std::memcpy(&h, p.dksh.data(), sizeof h);
+        offs.push_back(arena.place(h.code_size, DK_SHADER_CODE_ALIGNMENT));
+    }
+    (void)arena.place(DK_SHADER_CODE_UNUSABLE_SIZE, 1);
+    if (arena.overflowed()) return fail_fg("código grande demais");
+    g_code_mb = mem_block(arena.block_size(), DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached | DkMemBlockFlags_Code);
+    if (!g_code_mb) return fail_fg("sem memória para o código");
+    uint8_t *code = static_cast<uint8_t *>(dkMemBlockGetCpuAddr(g_code_mb));
+    g_shd.assign(g_cache.passes.size(), DkShader{});
+    for (size_t i = 0; i < g_cache.passes.size(); i++) {
+        const auto &p = g_cache.passes[i];
+        lsfg::dksh::FileHeader h;
+        std::memcpy(&h, p.dksh.data(), sizeof h);
+        std::memcpy(code + offs[i], p.dksh.data() + h.control_size, h.code_size);
+        DkShaderMaker sm;
+        dkShaderMakerDefaults(&sm, g_code_mb, offs[i]);
+        sm.control = p.dksh.data();
+        dkShaderInitialize(&g_shd[i], &sm);
+        if (!dkShaderIsValid(&g_shd[i])) return fail_fg("shader inválido");
+    }
+    g_loaded = mode;
+    vt::logf("dk: geração de quadros carregada (%s, %u passadas, ciclo %u, aquecimento %u)", mode == 2 ? "qualidade" : "desempenho",
+             (unsigned)g_cache.passes.size(), g_sched.cycle, g_sched.warmup_frames);
+    return true;
+}
+
+const DkImage *chain_image(uint32_t i) {
+    if (i < g_owned.size() && g_owned[i]) return &g_imgs[i];
+    if (i < graph::history_image_count) return &g_hist[i].im;
+    const uint32_t g = i - graph::history_image_count;
+    return g < g_gen.size() ? &g_gen[g].im : nullptr;
+}
+
+void describe_sampler(uint32_t i, DkSampler *s) {
+    dkSamplerDefaults(s);
+    s->minFilter = s->magFilter = DkFilter_Linear;
+    s->mipFilter = DkMipFilter_Linear;
+    const bool edge = i == (uint32_t)graph::Sampler::edge || i == backend::introduced_sampler;
+    for (DkWrapMode &m : s->wrapMode) m = edge ? DkWrapMode_ClampToEdge : DkWrapMode_ClampToBorder;
+    if (i == (uint32_t)graph::Sampler::border_white)
+        for (auto &c : s->borderColor) c.value_f = 1.f;
+}
+
+bool allocate(uint32_t w, uint32_t h) {
+    dkQueueWaitIdle(g_queue);
+    g_refused = false;
+    release_alloc();
+    backend::Request rq{};
+    rq.config = g_cfg;
+    rq.precision = lsfg::cache::Precision::high;
+    rq.output = {w, h};
+    rq.memory_budget_bytes = kBudget;
+    backend::Rejection why;
+    if (!backend::accept(g_cache, rq, g_plan, why))
+        return g_refused = true, fail_fg("plano recusado em " + std::to_string(w) + "x" + std::to_string(h) + ": " + std::string(why.reason));
+    if (g_plan.max_scratch_bytes_per_warp > 0x4000) return fail_fg("scratch por warp maior que o da fila");
+    if (!lsfg::succeeded(backend::describe(g_cache.graph, g_layout))) return fail_fg("descritores");
+    const size_t n = g_plan.images.size();
+    std::vector<DkImageLayout> lays(n);
+    std::vector<uint32_t> offs(n, 0);
+    g_imgs.assign(n, DkImage{});
+    g_owned.assign(n, false);
+    backend::Arena arena;
+    for (uint32_t i = 0; i < n; i++) {
+        const auto &ip = g_plan.images[i];
+        if (ip.role == graph::ImageRole::history) {
+            if (i >= graph::history_image_count || !img_make(g_hist[i], ip.extent.width, ip.extent.height, kColor, DkImageFlags_Usage2DEngine))
+                return fail_fg("memória (histórico)");
+            continue;
+        }
+        if (ip.role == graph::ImageRole::generated) {
+            g_gen.emplace_back();
+            if (!img_make(g_gen.back(), ip.extent.width, ip.extent.height, kColor, DkImageFlags_Usage2DEngine | DkImageFlags_UsageLoadStore))
+                return fail_fg("memória (quadro gerado)");
+            continue;
+        }
+        DkImageLayoutMaker lm;
+        dkImageLayoutMakerDefaults(&lm, g_dev);
+        // até 8 linhas: o deko3d monta com ladrilhos de um GOB e descreve com mais (invadiria a imagem seguinte)
+        lm.flags = DkImageFlags_UsageLoadStore | (ip.extent.height <= 8 ? DkImageFlags_CustomTileSize : 0);
+        lm.tileSize = DkTileSize_OneGob;
+        lm.format = ip.format == graph::Format::r8 ? DkImageFormat_R8_Unorm
+                    : ip.format == graph::Format::rgba16f ? DkImageFormat_RGBA16_Float : DkImageFormat_RGBA8_Unorm;
+        lm.dimensions[0] = ip.extent.width, lm.dimensions[1] = ip.extent.height;
+        dkImageLayoutInitialize(&lays[i], &lm);
+        offs[i] = arena.place(dkImageLayoutGetSize(&lays[i]), dkImageLayoutGetAlignment(&lays[i]));
+        g_owned[i] = true;
+    }
+    if (arena.overflowed()) return fail_fg("imagens não cabem num bloco");
+    g_img_mb = mem_block(arena.block_size(), DkMemBlockFlags_GpuCached | DkMemBlockFlags_Image | DkMemBlockFlags_ZeroFillInit);
+    if (!g_img_mb) return fail_fg("sem memória para as imagens");
+    for (uint32_t i = 0; i < n; i++)
+        if (g_owned[i]) dkImageInitialize(&g_imgs[i], &lays[i], g_img_mb, offs[i]);
+    g_desc_mb = mem_block((g_layout.image_descriptors + backend::sampler_descriptor_count) * kDesc,
+                          DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+    if (g_plan.uniform_buffers)
+        g_uni_mb = mem_block(g_plan.uniform_buffers * backend::uniform_buffer_stride, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+    if (!g_desc_mb || (g_plan.uniform_buffers && !g_uni_mb)) return fail_fg("sem memória para descritores");
+    uint8_t *tab = static_cast<uint8_t *>(dkMemBlockGetCpuAddr(g_desc_mb));
+    for (uint32_t i = 0; i < g_layout.images.size(); i++) {
+        const DkImage *im = chain_image(i);
+        if (!im) continue;
+        DkImageView v;
+        dkImageViewDefaults(&v, im);
+        const auto &e = g_layout.images[i];
+        if (e.sampled != backend::no_descriptor)
+            dkImageDescriptorInitialize(reinterpret_cast<DkImageDescriptor *>(tab + e.sampled * kDesc), &v, false, false);
+        if (e.storage != backend::no_descriptor)
+            dkImageDescriptorInitialize(reinterpret_cast<DkImageDescriptor *>(tab + e.storage * kDesc), &v, true, false);
+    }
+    uint8_t *smp = tab + g_layout.image_descriptors * kDesc;
+    for (uint32_t i = 0; i < backend::sampler_descriptor_count; i++) {
+        DkSampler s;
+        describe_sampler(i, &s);
+        dkSamplerDescriptorInitialize(reinterpret_cast<DkSamplerDescriptor *>(smp + i * kDesc), &s);
+    }
+    if (g_uni_mb) {
+        uint8_t *u = static_cast<uint8_t *>(dkMemBlockGetCpuAddr(g_uni_mb));
+        for (uint32_t i = 0; i < g_plan.uniform_buffers; i++) {
+            const graph::ConstantBuffer cb = graph::constant_buffer(i, g_cfg);
+            std::memcpy(u + i * backend::uniform_buffer_stride, &cb, sizeof cb);
+        }
+    }
+    g_haz.assign(g_cache.graph.images.size(), 0);
+    g_haz_list.clear();
+    g_w = w, g_h = h, g_since_reset = 0;
+    vt::logf("dk: geração de quadros em %ux%u (fluxo %ux%u, %u imagens próprias, %llu KB, scratch %u)", w, h, g_plan.flow.width,
+             g_plan.flow.height, g_plan.owned_images, (unsigned long long)(g_plan.owned_image_bytes >> 10), g_plan.max_scratch_bytes_per_warp);
+    return true;
+}
+
+constexpr uint8_t kRead = 1, kWritten = 2;
+void haz_clear() {
+    for (uint32_t i : g_haz_list) g_haz[i] = 0;
+    g_haz_list.clear();
+}
+void haz_mark(uint32_t i, uint8_t h) {
+    if (!g_haz[i]) g_haz_list.push_back(i);
+    g_haz[i] |= h;
+}
+
+bool record(uint32_t dispatch, uint32_t phase) {
+    backend::DispatchBinding b;
+    if (!lsfg::succeeded(backend::bind(g_cache, g_plan, g_layout, dispatch, phase, b))) return fail_fg("bind de passada");
+    bool wait = false;
+    uint32_t inv = 0;
+    for (uint32_t i = 0; i < b.texture_count; i++)
+        if (g_haz[b.textures[i].image] & kWritten) wait = true, inv |= DkInvalidateFlags_Image;
+    for (uint32_t i = 0; i < b.storage_count; i++)
+        if (g_haz[b.storages[i].image]) wait = true;
+    if (wait) dkCmdBufBarrier(g_cmd, DkBarrier_Primitives, inv), haz_clear();
+    for (uint32_t i = 0; i < b.texture_count; i++) haz_mark(b.textures[i].image, kRead);
+    for (uint32_t i = 0; i < b.storage_count; i++) haz_mark(b.storages[i].image, kWritten);
+    const DkShader *sh = &g_shd[b.pass];
+    dkCmdBufBindShaders(g_cmd, DkStageFlag_Compute, &sh, 1);
+    DkResHandle tex[backend::max_texture_slots] = {};
+    uint32_t nt = 0;
+    for (uint32_t i = 0; i < b.texture_count; i++) {
+        const auto &t = b.textures[i];
+        tex[t.slot] = dkMakeTextureHandle(t.descriptor, t.sampler);
+        nt = std::max(nt, t.slot + 1);
+    }
+    if (nt) dkCmdBufBindTextures(g_cmd, DkStage_Compute, 0, tex, nt);
+    DkResHandle st[backend::max_storage_slots] = {};
+    uint32_t ns = 0;
+    for (uint32_t i = 0; i < b.storage_count; i++) {
+        const auto &s = b.storages[i];
+        st[s.slot] = dkMakeImageHandle(s.descriptor);
+        ns = std::max(ns, s.slot + 1);
+    }
+    if (ns) dkCmdBufBindImages(g_cmd, DkStage_Compute, 0, st, ns);
+    if (b.uniform_slot != backend::no_slot)
+        dkCmdBufBindUniformBuffer(g_cmd, DkStage_Compute, b.uniform_slot,
+                                  dkMemBlockGetGpuAddr(g_uni_mb) + b.uniform_buffer * backend::uniform_buffer_stride,
+                                  backend::uniform_buffer_stride);
+    dkCmdBufDispatchCompute(g_cmd, b.groups_x, b.groups_y, 1);
+    return true;
+}
+
+// Grava a geração na lista atual a partir do alvo do quadro real. Devolve o quadro gerado (do meio entre o real
+// anterior e este) ou nullptr enquanto aquece ou se falhou.
+const Img *generate(const Img &src) {
+    if (!g_mode || g_failed) return nullptr;
+    if (g_loaded != g_mode) {
+        unload();
+        if (!load(g_mode)) return nullptr;
+    }
+    if (g_flow_cap < 4 && (src.w != g_cap_w || src.h != g_cap_h)) { // outra resolução: tenta o fluxo pedido de novo
+        g_flow_cap = 4, unload();
+        return nullptr;
+    }
+    if ((src.w != g_w || src.h != g_h) && !allocate(src.w, src.h)) {
+        release_alloc();
+        if (g_refused && g_cfg.flow_denominator > 1) {
+            g_flow_cap = g_cfg.flow_denominator - 1, g_cap_w = src.w, g_cap_h = src.h;
+            vt::logf("dk: fluxo 1/%u não serve em %ux%u; tentando 1/%u", g_cfg.flow_denominator, src.w, src.h, flow_for(g_mode));
+            g_failed = g_refused = false;
+            unload();
+        }
+        return nullptr;
+    }
+    // o alvo acabou de ser desenhado (cache em ladrilhos e fragmentos)
+    barrier(DkBarrier_Fragments, DkInvalidateFlags_Image);
+    DkImageView sv, hv;
+    dkImageViewDefaults(&sv, &src.im);
+    dkImageViewDefaults(&hv, &g_hist[g_frame % graph::history_image_count].im);
+    const DkImageRect r{0, 0, 0, src.w, src.h, 1};
+    dkCmdBufBlitImage(g_cmd, &sv, &r, &hv, &r, DkBlitFlag_FilterNearest | DkBlitFlag_ModeBlit, 0);
+    const DkGpuAddr dg = dkMemBlockGetGpuAddr(g_desc_mb);
+    dkCmdBufBindImageDescriptorSet(g_cmd, dg, g_layout.image_descriptors);
+    dkCmdBufBindSamplerDescriptorSet(g_cmd, dg + g_layout.image_descriptors * kDesc, backend::sampler_descriptor_count);
+    dkCmdBufBarrier(g_cmd, DkBarrier_Full, DkInvalidateFlags_Image | DkInvalidateFlags_Descriptors);
+    haz_clear();
+    bool ok = true;
+    for (uint32_t d = 0; ok && d < g_cache.graph.dispatches.size(); d++) ok = record(d, g_frame);
+    dkCmdBufBarrier(g_cmd, DkBarrier_Primitives, DkInvalidateFlags_Image | DkInvalidateFlags_Descriptors);
+    // de volta às tabelas do renderizador
+    dkCmdBufBindImageDescriptorSet(g_cmd, g_img_desc_gpu, kMaxImgDesc);
+    dkCmdBufBindSamplerDescriptorSet(g_cmd, g_smp_desc_gpu, kMaxSmpDesc);
+    dkCmdBufBarrier(g_cmd, DkBarrier_None, DkInvalidateFlags_Descriptors);
+    g_b = Bound{};
+    if (!ok) return nullptr;
+    g_frame = (g_frame + 1) % g_sched.cycle;
+    return ++g_since_reset > g_sched.warmup_frames && !g_gen.empty() ? &g_gen[0] : nullptr;
+}
+void reset() { g_since_reset = 0; }
+
+// Ritmo: só gera com o jogo perto de 30 FPS (intervalo entre quadros reais >= 28 ms). Pausa longa zera o histórico
+// (o quadro do meio sairia de duas cenas diferentes).
+double g_ema = 0;
+uint32_t g_samples = 0, g_slow = 0, g_late = 0, g_late_n = 0;
+bool g_on = false;
+uint64_t g_last_tick = 0;
+bool should_generate() {
+    const uint64_t now = armGetSystemTick();
+    const double ms = g_last_tick ? armTicksToNs(now - g_last_tick) / 1e6 : 0;
+    g_last_tick = now;
+    if (!g_mode || g_failed) return g_on = false;
+    if (!ms || ms > 250) {
+        reset();
+        g_samples = g_slow = 0, g_on = false;
+        return false;
+    }
+    if (ms >= 4 && ms <= 100) g_ema = g_samples++ ? g_ema * 0.875 + ms * 0.125 : ms;
+    g_slow = ms >= 26 ? g_slow + 1 : 0;
+    // orçamento: 33,3 ms por quadro real a 30 FPS. Ligada e passando de 32 ms, pausa 5 s; volta só se o jogo
+    // sozinho mais o último custo medido da geração couber em 30 ms (a GPU mede com 2 quadros de atraso)
+    if (g_on && g_fgb_n >= 30 && g_fgb_tot > 32) {
+        vt::logf("dk: geração de quadros pausada: GPU %.1f ms por quadro (geração %.1f ms) não cabe em 33 ms", g_fgb_tot, g_fgb_fg);
+        g_on = false, g_fgb_n = 0, g_fgb_hold = now + armNsToTicks(5000000000ull);
+        reset();
+        return false;
+    }
+    // quadros perdidos: com a geração ligada a 30 FPS, um quadro real acima de ~38 ms perde um vblank (50 ms na tela)
+    // e o jogo parece lento; 6 em 60 quadros pausam a geração (o GoW2 passa do orçamento mais que o GoW1)
+    if (g_on) {
+        g_late_n++;
+        if (ms > 38) g_late++;
+        if (g_late_n >= 60) {
+            if (g_late >= 6) {
+                vt::logf("dk: geração de quadros pausada: %u de %u quadros acima de 38 ms (GPU %.1f ms, geração %.1f ms)", g_late, g_late_n, g_fgb_tot, g_fgb_fg);
+                g_on = false, g_fgb_n = 0, g_fgb_hold = now + armNsToTicks(5000000000ull);
+                g_late = g_late_n = 0;
+                reset();
+                return false;
+            }
+            g_late = g_late_n = 0;
+        }
+    } else g_late = g_late_n = 0;
+    if (!g_on && g_fgb_hold && now < g_fgb_hold) return false;
+    if (!g_on && g_slow >= 8) {
+        if (g_fgb_hold && g_fgb_fg > 0 && (g_fgb_n < 30 || g_fgb_tot + g_fgb_fg > 27)) {
+            g_fgb_hold = now + armNsToTicks(2000000000ull); // ainda pesado: espera mais
+            return false;
+        }
+        if (g_fgb_hold) vt::logf("dk: geração de quadros retomada: jogo %.1f ms + geração %.1f ms", g_fgb_tot, g_fgb_fg);
+        g_on = true, g_fgb_hold = 0, g_fgb_n = 0, reset();
+    }
+    else if (g_on && g_samples >= 8 && g_ema < 24) g_on = false;
+    return g_on;
+}
+} // namespace fg
+#endif
+
+
+} // namespace
+
+// ================================================================ interface (gxm_api.inc)
+
+bool vertex_format_ok(uint32_t fmt, uint32_t comps) { return fmt <= 9 && comps >= 1 && comps <= 4; }
+
+bool init(bool validation, bool window) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    (void)validation;
+    DkDeviceMaker dm;
+    dkDeviceMakerDefaults(&dm);
+    dm.cbDebug = dbg_cb;
+    g_dev = dkDeviceCreate(&dm);
+    if (!g_dev) return fail("dkDeviceCreate falhou");
+    if (FILE *f = std::fopen((vt::data_path() + "/vitart_options.ini").c_str(), "r")) {
+        char l[256];
+        unsigned v;
+        while (std::fgets(l, sizeof l, f)) {
+            if (std::sscanf(l, "dk_tile=%u", &v) == 1) g_tile = v > 256 ? 256 : v;
+            if (std::sscanf(l, "dk_depth=%u", &v) == 1) g_z24 = v != 32;
+            if (std::sscanf(l, "dk_gpu_diag=%u", &v) == 1) g_diag = v != 0;
+            if (std::sscanf(l, "dk_blit3d=%u", &v) == 1) g_blit3d = v != 0;
+#ifdef VITART_LSFG
+            if (std::sscanf(l, "fg_flow=%u", &v) == 1) fg::g_flow = v < 1 ? 1 : v > 4 ? 4 : v;
+#endif
+        }
+        std::fclose(f);
+    }
+    kDepth = g_z24 ? DkImageFormat_Z24S8 : DkImageFormat_ZF32_X24S8;
+    vt::logf("dk: cache em ladrilhos %s (dk_tile=%u), profundidade %s (dk_depth)", g_tile ? "ligado" : "desligado", g_tile,
+             g_z24 ? "Z24S8" : "Z32F_S8");
+    DkQueueMaker qm;
+    dkQueueMakerDefaults(&qm, g_dev);
+    qm.flags = DkQueueFlags_Graphics | DkQueueFlags_MediumPrio | DkQueueFlags_EnableZcull;
+#ifdef VITART_LSFG
+    qm.flags |= DkQueueFlags_Compute; // a geração de quadros (LSFG) roda em shaders de compute nesta fila
+#endif
+    qm.commandMemorySize = 1u << 20;
+    qm.flushThreshold = 128u << 10;
+    qm.perWarpScratchMemorySize = 0x4000; // os shaders medidos não usam memória local; folga para os que usarem
+    g_queue = dkQueueCreate(&qm);
+    if (!g_queue) return fail("dkQueueCreate falhou");
+
+    g_img_heap.flags = DkMemBlockFlags_GpuCached | DkMemBlockFlags_Image;
+    const uint32_t dsz = kMaxImgDesc * sizeof(DkImageDescriptor) + kMaxSmpDesc * sizeof(DkSamplerDescriptor);
+    g_desc_mem = mem_block(dsz, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+    if (!g_desc_mem) return fail("sem memória para descritores");
+    g_img_desc = static_cast<DkImageDescriptor *>(dkMemBlockGetCpuAddr(g_desc_mem));
+    g_smp_desc = reinterpret_cast<DkSamplerDescriptor *>(g_img_desc + kMaxImgDesc);
+    g_img_desc_gpu = dkMemBlockGetGpuAddr(g_desc_mem);
+    g_smp_desc_gpu = g_img_desc_gpu + kMaxImgDesc * sizeof(DkImageDescriptor);
+    std::memset(g_img_desc, 0, dsz);
+    for (uint32_t i = kMaxImgDesc; i-- > 0;) g_img_desc_free.push_back(i);
+    sampler_idx(true, true, 2, 2, false, false, 31); // índice 0: linear, borda presa
+
+    for (Slot &s : g_slots) {
+        s.ring = mem_block(kRing + kRingSlack, DkMemBlockFlags_CpuCached | DkMemBlockFlags_GpuCached); // memcpy rápido; descarga no envio
+        s.cmd = mem_block(kCmdMem, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+        s.up = mem_block(kCmdChunk * 4, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+        s.ts = mem_block(DK_MEMBLOCK_ALIGNMENT, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+        if (!s.ring || !s.cmd || !s.up || !s.ts) return fail("sem memória para as vagas do quadro");
+        s.ring_cpu = static_cast<uint8_t *>(dkMemBlockGetCpuAddr(s.ring));
+        s.ring_gpu = dkMemBlockGetGpuAddr(s.ring);
+        std::memset(dkMemBlockGetCpuAddr(s.ts), 0, 64);
+    }
+    if (g_diag) {
+        for (uint32_t i = 0; i < kSlots; i++) {
+            g_dts[i] = mem_block(kDiagTs * 16, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+            g_drec[i].reserve(kDiagTs / 2);
+        }
+        vt::logf("dk: diagnostico de GPU por desenho ligado (dk_gpu_diag=1): 1 vaga a cada %u, ranking a cada %u", kDiagEvery,
+                 kDiagFrames);
+    }
+    DkCmdBufMaker cm;
+    dkCmdBufMakerDefaults(&cm, g_dev);
+    cm.cbAddMem = add_mem;
+    cm.userData = nullptr;
+    g_cmd = dkCmdBufCreate(&cm);
+    cm.userData = reinterpret_cast<void *>(1);
+    g_up = dkCmdBufCreate(&cm);
+    g_code = mem_block(kCode, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached | DkMemBlockFlags_Code);
+    if (!g_cmd || !g_up || !g_code) return fail("sem memória para comandos/código");
+    if (!pak_open()) return false;
+    g_blit_vs = shader_from_dksh(k_blit_vs, sizeof k_blit_vs), g_blit_fs = shader_from_dksh(k_blit_fs, sizeof k_blit_fs);
+    g_fxaa_fs = shader_from_dksh(k_fxaa_fs, sizeof k_fxaa_fs), g_easu_fs = shader_from_dksh(k_easu_fs, sizeof k_easu_fs);
+    g_post_fs = shader_from_dksh(k_post_fs, sizeof k_post_fs);
+    g_nv12_fs = shader_from_dksh(k_nv12_fs, sizeof k_nv12_fs);
+    if (!g_nv12_fs) vt::logf("dk: shader NV12 indisponível: sem cenas remasterizadas");
+    vt::logf("dk: pós-processamento %s", g_post_fs && g_fxaa_fs && g_easu_fs ? "pronto" : "indisponível (shaders)");
+    vt::logf("dk: copias de alvo pelo %s", g_blit3d && g_blit_vs && g_blit_fs ? "3D (dk_blit3d=1)" : "motor 2D");
+    cq_start();
+
+    if (!reserve(64)) return false;
+    const uint8_t white[4] = {255, 255, 255, 255};
+    if (!upload_texture(g_white, 1, 1, white, false)) return false;
+    if (window) {
+        win::create(L"God of War");
+        if (!create_swapchain()) return false;
+    }
+    vt::logf("dk: deko3d pronto (anel %u MB x %u, heap de imagens em blocos de %u MB)", kRing >> 20, kSlots,
+             g_img_heap.chunk >> 20);
+    return true;
+}
+
+bool draw(const Draw &d) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    if (!d.vs || !d.fs || !d.index_count || !d.vertex_count || !d.target_w || !d.target_h) return true;
+    if (d.debug_vs) return true; // sem leitura de volta neste renderizador
+    const DkShader *vs, *fs;
+    {
+        Timer t(g_stats.pipe_ns);
+        vs = shader_for(d.vs, d.vs_size), fs = shader_for(d.fs, d.fs_size);
+    }
+    DKT("draw alvo %08x %ux%u prof %08x vc %u ic %u top %u raw %d attrs %u tex %u vu %u fu %u", d.target_addr, d.target_w,
+        d.target_h, d.depth_addr, d.vertex_count, d.index_count, d.topology, (int)!d.raw_attrs.empty(),
+        (unsigned)(d.raw_attrs.empty() ? d.attr_count : d.raw_attrs.size()), (unsigned)d.textures.size(), d.vert_uniforms_size,
+        d.frag_uniforms_size);
+    DKT("  estado blend %d %08x prof %u/%u sten %d tex:%s%s%s%s", (int)d.has_blend, d.blend, d.depth_func, (unsigned)d.depth_write,
+        (int)d.stencil, d.textures.size() > 0 ? (d.textures[0].target_addr ? " alvo" : " img") : "",
+        d.textures.size() > 1 ? (d.textures[1].target_addr ? " alvo" : " img") : "", d.textures.size() > 2 ? " +" : "",
+        d.pbr ? " PBR" : "");
+    if (!vs || !fs) return true; // shader fora do pacote: o desenho some (logado uma vez)
+
+    const bool raw = !d.raw_attrs.empty();
+    const uint32_t na = raw ? (uint32_t)std::min<size_t>(d.raw_streams.size(), 16) : std::min<uint32_t>(d.attr_count, 16);
+    uint64_t need = 64 * 1024 + (uint64_t)d.index_count * (d.index_data ? d.index_size : 4) + d.vert_uniforms_size +
+                    d.frag_uniforms_size + 1024;
+    if (raw)
+        for (const VertexStream &st : d.raw_streams) need += st.size + 16;
+    else
+        need += (uint64_t)na * d.vertex_count * 16;
+    uint64_t keys[16] = {};
+    for (size_t i = 0; i < d.textures.size() && i < 16; i++) {
+        const Texture &t = d.textures[i];
+        if (t.target_addr || !t.rgba) continue;
+        keys[i] = t.key ? t.key : fnv(t.rgba, (size_t)t.width * t.height * 4, fnv(&t.width, 8));
+        if (!g_textures.count(keys[i])) need += (uint64_t)t.width * t.height * 4 * 2 + 4096;
+    }
+    if (need > kRing) return true;
+    if (!reserve((uint32_t)need)) return false;
+    Target *tgt;
+    if (!get_target(d.target_addr, d.target_w, d.target_h, tgt)) return false;
+    if (d.depth_addr) g_depth_owner[d.depth_addr] = d.target_addr;
+    if (d.depth_write) g_dw_frame++;
+
+    // texturas: binding 0..15 do fragmento; vazio = branca
+    const uint32_t white_smp = 0;
+    DkResHandle tex[16];
+    for (auto &h : tex) h = dkMakeTextureHandle(g_white.desc, white_smp);
+    for (size_t ti = 0; ti < d.textures.size(); ti++) {
+        const Texture &t = d.textures[ti];
+        if (t.binding >= 16) continue;
+        const bool mipped = t.mip_count != 0 && t.rgba && !t.target_addr;
+        const uint32_t smp = t.depth ? sampler_idx(false, false, 2, 2, false, false, 31)
+                                     : sampler_idx(t.mag & 1, t.min & 1, t.addr_u, t.addr_v, mipped, t.mip_filter & 1, t.lod_bias);
+        if (t.target_addr) {
+            uint32_t owner = t.target_addr;
+            if (t.depth) {
+                auto o = g_depth_owner.find(t.target_addr);
+                if (o == g_depth_owner.end()) continue;
+                owner = o->second;
+            }
+            auto it = g_targets.find(owner);
+            if (it == g_targets.end()) continue;
+            Target &src = it->second;
+            if (t.depth) {
+                tex[t.binding] = dkMakeTextureHandle(src.depth.desc, smp);
+            } else if (&src == tgt) {
+                // lendo o alvo em que desenha: a cópia de quando a cena começou (como o Vita por ladrilhos)
+                src.le_a_si = true;
+                if (!snap_own(src)) return false;
+                bind_target(*tgt);
+                tex[t.binding] = dkMakeTextureHandle(src.snap.desc, smp);
+            } else {
+                tex[t.binding] = dkMakeTextureHandle(src.color.desc, smp);
+            }
+            continue;
+        }
+        if (!t.rgba) continue;
+        const uint64_t h = keys[ti];
+        auto it = g_textures.find(h);
+        if (it == g_textures.end()) {
+            Tex nt;
+            nt.born = g_frame_no;
+            if (!upload_texture(nt.img, t.width, t.height, t.rgba, mipped && t.width > 1 && t.height > 1)) return false;
+            it = g_textures.emplace(h, nt).first;
+        }
+        it->second.used = g_frame_no;
+        tex[t.binding] = dkMakeTextureHandle(it->second.img.desc, smp);
+    }
+    tgt->color.ok = true;
+
+    // dados no anel
+    Timer tr(g_stats.ring_ns);
+    DkBufExtents vb[16];
+    DkVtxBufferState vbs[16];
+    DkVtxAttribState va[32];
+    uint32_t nloc = 0;
+    std::memset(va, 0, sizeof va);
+    if (raw) {
+        for (uint32_t k = 0; k < na; k++) {
+            const VertexStream &st = d.raw_streams[k];
+            const uint32_t off = ring_put_g(st.data, st.size, 16, (d.guest_mask >> k) & 1);
+            vb[k] = {ring_gpu(off), st.size ? st.size : 16};
+            vbs[k] = {st.stride, 0};
+        }
+        static const DkVtxAttribType types[10] = {DkVtxAttribType_Uscaled, DkVtxAttribType_Sscaled, DkVtxAttribType_Uscaled,
+                                                  DkVtxAttribType_Sscaled, DkVtxAttribType_Unorm,   DkVtxAttribType_Snorm,
+                                                  DkVtxAttribType_Unorm,   DkVtxAttribType_Snorm,   DkVtxAttribType_Float,
+                                                  DkVtxAttribType_Float};
+        static const DkVtxAttribSize s8[4] = {DkVtxAttribSize_1x8, DkVtxAttribSize_2x8, DkVtxAttribSize_3x8, DkVtxAttribSize_4x8};
+        static const DkVtxAttribSize s16[4] = {DkVtxAttribSize_1x16, DkVtxAttribSize_2x16, DkVtxAttribSize_3x16, DkVtxAttribSize_4x16};
+        static const DkVtxAttribSize s32[4] = {DkVtxAttribSize_1x32, DkVtxAttribSize_2x32, DkVtxAttribSize_3x32, DkVtxAttribSize_4x32};
+        for (const VertexAttr &a : d.raw_attrs) {
+            if (a.location >= 32 || a.stream >= na || a.fmt > 9 || a.comps < 1 || a.comps > 4) continue;
+            DkVtxAttribState &s = va[a.location];
+            s.bufferId = a.stream;
+            s.isFixed = 0;
+            s.offset = a.offset;
+            const uint32_t c = a.comps - 1;
+            s.size = a.fmt <= 1 || a.fmt == 4 || a.fmt == 5 ? s8[c] : a.fmt == 9 ? s32[c] : s16[c];
+            s.type = types[a.fmt];
+            nloc = std::max(nloc, a.location + 1);
+        }
+        // locations sem atributo: valor fixo
+        for (uint32_t l = 0; l < nloc; l++)
+            if (!va[l].type) va[l].isFixed = 1, va[l].size = DkVtxAttribSize_4x32, va[l].type = DkVtxAttribType_Float;
+    } else {
+        const uint32_t off = ring_put(d.attrs, na * d.vertex_count * 16, 16);
+        for (uint32_t k = 0; k < na; k++) {
+            vb[k] = {ring_gpu(off + k * d.vertex_count * 16), d.vertex_count * 16};
+            vbs[k] = {16, 0};
+            va[k].bufferId = k, va[k].offset = 0, va[k].size = DkVtxAttribSize_4x32, va[k].type = DkVtxAttribType_Float;
+        }
+        nloc = na;
+    }
+    const uint32_t isz = d.index_data ? d.index_size : 4;
+    const uint32_t ioff = d.index_data ? ring_put_g(d.index_data, d.index_count * isz, 16, (d.guest_mask >> 16) & 1)
+                                       : ring_put(d.indices, d.index_count * isz, 16);
+    const uint32_t vuoff = ring_put_g(d.vert_uniforms, d.vert_uniforms_size, DK_UNIFORM_BUF_ALIGNMENT, (d.guest_mask >> 17) & 1);
+    const uint32_t fuoff = ring_put_g(d.frag_uniforms, d.frag_uniforms_size, DK_UNIFORM_BUF_ALIGNMENT, (d.guest_mask >> 18) & 1);
+
+    // estado
+    DkCmdBuf c = g_cmd;
+    bind_target(*tgt);
+    if (!g_b.valid || g_b.vs != vs || g_b.fs != fs) {
+        const DkShader *sh[2] = {vs, fs};
+        dkCmdBufBindShaders(c, DkStageFlag_GraphicsMask, sh, 2);
+        g_b.vs = vs, g_b.fs = fs;
+    }
+    // blend
+    uint32_t wmask = DkColorMask_RGBA;
+    bool blend_on = false;
+    DkBlendState bs;
+    dkBlendStateDefaults(&bs);
+    if (d.has_blend) {
+        static const DkBlendFactor fac[12] = {DkBlendFactor_Zero,        DkBlendFactor_One,      DkBlendFactor_SrcColor,
+                                              DkBlendFactor_InvSrcColor, DkBlendFactor_SrcAlpha, DkBlendFactor_InvSrcAlpha,
+                                              DkBlendFactor_DstColor,    DkBlendFactor_InvDstColor, DkBlendFactor_DstAlpha,
+                                              DkBlendFactor_InvDstAlpha, DkBlendFactor_SrcAlphaSaturate, DkBlendFactor_One};
+        auto f = [](uint32_t v) { return v < 12 ? fac[v] : DkBlendFactor_One; };
+        auto op = [](uint32_t v) {
+            return v == 2 ? DkBlendOp_Sub : v == 3 ? DkBlendOp_RevSub : v == 4 ? DkBlendOp_Min : v == 5 ? DkBlendOp_Max : DkBlendOp_Add;
+        };
+        const uint32_t b = d.blend, m = b & 0xFF, cf = (b >> 8) & 15, af = (b >> 12) & 15;
+        wmask = ((m & 2) ? DkColorMask_R : 0) | ((m & 4) ? DkColorMask_G : 0) | ((m & 8) ? DkColorMask_B : 0) | ((m & 1) ? DkColorMask_A : 0);
+        blend_on = cf || af;
+        bs.colorBlendOp = op(cf), bs.alphaBlendOp = op(af);
+        bs.srcColorBlendFactor = cf ? f((b >> 16) & 15) : DkBlendFactor_One;
+        bs.dstColorBlendFactor = cf ? f((b >> 20) & 15) : DkBlendFactor_Zero;
+        bs.srcAlphaBlendFactor = af ? f((b >> 24) & 15) : DkBlendFactor_One;
+        bs.dstAlphaBlendFactor = af ? f((b >> 28) & 15) : DkBlendFactor_Zero;
+    }
+    if (!g_b.valid || g_b.cs != (uint32_t)blend_on) {
+        DkColorState cs;
+        dkColorStateDefaults(&cs);
+        dkColorStateSetBlendEnable(&cs, 0, blend_on);
+        dkCmdBufBindColorState(c, &cs);
+        g_b.cs = blend_on;
+    }
+    if (!g_b.valid || g_b.cw != wmask) {
+        DkColorWriteState cw;
+        dkColorWriteStateDefaults(&cw);
+        dkColorWriteStateSetMask(&cw, 0, wmask);
+        dkCmdBufBindColorWriteState(c, &cw);
+        g_b.cw = wmask;
+    }
+    if (blend_on && (!g_b.valid || std::memcmp(&g_b.bs, &bs, sizeof bs))) {
+        dkCmdBufBindBlendStates(c, 0, &bs, 1);
+        g_b.bs = bs;
+    }
+    // profundidade e stencil (enums do GXM na ordem do Vulkan; no deko3d começam em 1)
+    DkDepthStencilState ds;
+    dkDepthStencilStateDefaults(&ds);
+    ds.depthTestEnable = 1;
+    ds.depthWriteEnable = d.depth_write;
+    ds.depthCompareOp = (DkCompareOp)((d.depth_func & 7) + 1);
+    auto idle = [](const Stencil &s) { return (s.func & 7) == 7 && !s.fail && !s.zfail && !s.zpass; };
+    const bool sten = d.stencil && !(idle(d.front) && idle(d.back));
+    if (sten) {
+        ds.stencilTestEnable = 1;
+        ds.stencilFrontFailOp = (DkStencilOp)((d.front.fail & 7) + 1);
+        ds.stencilFrontDepthFailOp = (DkStencilOp)((d.front.zfail & 7) + 1);
+        ds.stencilFrontPassOp = (DkStencilOp)((d.front.zpass & 7) + 1);
+        ds.stencilFrontCompareOp = (DkCompareOp)((d.front.func & 7) + 1);
+        ds.stencilBackFailOp = (DkStencilOp)((d.back.fail & 7) + 1);
+        ds.stencilBackDepthFailOp = (DkStencilOp)((d.back.zfail & 7) + 1);
+        ds.stencilBackPassOp = (DkStencilOp)((d.back.zpass & 7) + 1);
+        ds.stencilBackCompareOp = (DkCompareOp)((d.back.func & 7) + 1);
+    } else {
+        ds.stencilFrontPassOp = ds.stencilBackPassOp = DkStencilOp_Keep;
+    }
+    if (!g_b.valid || std::memcmp(&g_b.ds, &ds, sizeof ds)) {
+        dkCmdBufBindDepthStencilState(c, &ds);
+        g_b.ds = ds;
+    }
+    const uint8_t st6[6] = {d.front.wmask, d.front.ref, d.front.cmask, d.back.wmask, d.back.ref, d.back.cmask};
+    if (sten && (!g_b.valid || std::memcmp(g_b.sten, st6, 6))) {
+        dkCmdBufSetStencil(c, DkFace_Front, st6[0], st6[1], st6[2]);
+        dkCmdBufSetStencil(c, DkFace_Back, st6[3], st6[4], st6[5]);
+        std::memcpy(g_b.sten, st6, 6);
+    }
+    // viewport do GXM (tela = deslocamento + escala * ndc), com o meio pixel do D3D9 e a escala do alvo
+    const float rsx = tgt->gw ? (float)tgt->color.w / (float)tgt->gw : g_scale;
+    const float rsy = tgt->gh ? (float)tgt->color.h / (float)tgt->gh : g_scale;
+    DkViewport vp{d.vps[0] - d.vps[1], d.vps[2] - d.vps[3], 2 * d.vps[1], 2 * d.vps[3], d.vps[4], d.vps[4] + d.vps[5]};
+    vp.x = (vp.x + 0.5f) * rsx, vp.y = (vp.y + 0.5f) * rsy, vp.width *= rsx, vp.height *= rsy;
+    vp.near = std::min(1.f, std::max(0.f, vp.near));
+    vp.far = std::min(1.f, std::max(0.f, vp.far));
+    // O deko3d grava largura/altura da viewport também como retângulo de recorte (sem sinal): altura negativa
+    // (a inversão vertical do GXM) vira recorte vazio e nada é rasterizado. A inversão vai para o swizzle.
+    // No console a imagem saiu invertida com Y negado na altura negativa: o Y do deko3d é o oposto do Vulkan,
+    // então nega-se Y quando a altura era positiva e deixa-se como está quando era negativa.
+    int flip = 1;
+    if (vp.height < 0) vp.y += vp.height, vp.height = -vp.height, flip = 0;
+    if (vp.width < 0) vp.x += vp.width, vp.width = -vp.width, flip |= 2;
+    if (!g_b.valid || g_b.flip != flip) {
+        const DkViewportSwizzle sw{(flip & 2) ? DkSwizzle_NegativeX : DkSwizzle_PositiveX,
+                                   (flip & 1) ? DkSwizzle_NegativeY : DkSwizzle_PositiveY, DkSwizzle_PositiveZ, DkSwizzle_PositiveW};
+        dkCmdBufSetViewportSwizzles(c, 0, &sw, 1);
+        g_b.flip = flip;
+    }
+    DKT("  vp %.1f %.1f %.1f %.1f z %.2f %.2f flip %d (vps %.1f %.1f %.1f %.1f)", vp.x, vp.y, vp.width, vp.height, vp.near, vp.far,
+        flip, d.vps[0], d.vps[1], d.vps[2], d.vps[3]);
+    if (!g_b.valid || std::memcmp(&g_b.vp, &vp, sizeof vp)) {
+        dkCmdBufSetViewports(c, 0, &vp, 1);
+        g_b.vp = vp;
+    }
+    if (!g_b.tex_ok || std::memcmp(g_b.tex, tex, sizeof tex)) {
+        dkCmdBufBindTextures(c, DkStage_Fragment, 0, tex, 16);
+        std::memcpy(g_b.tex, tex, sizeof tex);
+        g_b.tex_ok = true;
+    }
+    g_b.valid = true;
+    // memória (binding 1, só os shaders de vértice a leem) no mesmo deslocamento dos uniforms, como os conjuntos
+    // dinâmicos do Vulkan. Com o shaders_dk.pak de UBO nenhum shader lê o binding 0 como storage, e nenhum de
+    // fragmento usa o 1: esses binds saíram (cada um regrava a constbuf do driver).
+    const DkBufExtents vmem{ring_gpu(vuoff), kUBWindow};
+    dkCmdBufBindStorageBuffers(c, DkStage_Vertex, 1, &vmem, 1);
+    // shaders_dk.pak novo lê os uniforms como UBO (cache de constantes, janela máxima de 64 KB)
+    const DkBufExtents vub{ring_gpu(vuoff), 0x10000}, fub{ring_gpu(fuoff), 0x10000};
+    dkCmdBufBindUniformBuffers(c, DkStage_Vertex, 0, &vub, 1);
+    dkCmdBufBindUniformBuffers(c, DkStage_Fragment, 0, &fub, 1);
+    // estados de vértice iguais ao desenho anterior não são regravados (cada um são dezenas de registradores)
+    if (g_b.nloc != nloc || std::memcmp(g_b.va, va, nloc * sizeof va[0])) {
+        dkCmdBufBindVtxAttribState(c, va, nloc);
+        std::memcpy(g_b.va, va, nloc * sizeof va[0]);
+        g_b.nloc = nloc;
+    }
+    if (g_b.na != na || std::memcmp(g_b.vbs, vbs, na * sizeof vbs[0])) {
+        dkCmdBufBindVtxBufferState(c, vbs, na);
+        std::memcpy(g_b.vbs, vbs, na * sizeof vbs[0]);
+        g_b.na = na;
+    }
+    dkCmdBufBindVtxBuffers(c, 0, vb, na);
+    dkCmdBufBindIdxBuffer(c, isz == 2 ? DkIdxFormat_Uint16 : DkIdxFormat_Uint32, ring_gpu(ioff));
+    const DkPrimitive prim = d.topology == 1 ? DkPrimitive_TriangleStrip : d.topology == 2 ? DkPrimitive_TriangleFan : DkPrimitive_Triangles;
+    DKT("  DrawIndexed nloc %u na %u isz %u voff %u ring %u KB", nloc, na, isz, d.vertex_offset, g_ring_off >> 10);
+    const bool dg = g_dcap[g_si] && (g_drec[g_si].size() + 1) * 2 <= kDiagTs;
+    if (dg) dkCmdBufReportCounter(c, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_dts[g_si]) + 32 * g_drec[g_si].size());
+    dkCmdBufDrawIndexed(c, prim, d.index_count, 1, 0, d.index_data ? d.vertex_offset : 0, 0);
+    if (dg) {
+        dkCmdBufReportCounter(c, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_dts[g_si]) + 32 * g_drec[g_si].size() + 16);
+        auto hs = [](const DkShader *sh, const uint32_t *code, uint32_t sz) {
+            auto it = g_sh_hash.find(sh);
+            return it != g_sh_hash.end() ? it->second : (g_sh_hash[sh] = fnv(code, sz));
+        };
+        const uint32_t ntex = (uint32_t)std::min<size_t>(d.textures.size(), 255);
+        g_drec[g_si].push_back({hs(vs, d.vs, d.vs_size), hs(fs, d.fs, d.fs_size), d.target_w << 16 | d.target_h, d.index_count,
+                                (d.has_blend ? 1u : 0u) | (d.depth_write ? 2u : 0u) | (d.pbr ? 4u : 0u) | ntex << 8});
+    }
+    g_stats.draws++;
+    return true;
+}
+
+void begin_scene(uint32_t color_addr, uint8_t stencil) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    DKT("begin_scene %08x", color_addr);
+    auto it = g_targets.find(color_addr);
+    if (!g_dev || it == g_targets.end() || !reserve(1024)) return;
+    Target &t = it->second;
+    bind_target(t);
+    dkCmdBufClearDepthStencil(g_cmd, true, 1.0f, 0xFF, stencil);
+    t.cena++;
+    if (t.le_a_si) {
+        snap_own(t);
+        bind_target(t);
+    }
+}
+
+bool read_target(uint32_t addr, std::vector<uint8_t> &rgba, uint32_t &w, uint32_t &h);
+
+// Diagnóstico da tela preta: média de cor e fração de pixels não pretos de uma leitura RGBA.
+void px_stats(const char *what, uint32_t addr, const uint8_t *p, uint32_t w, uint32_t h, uint32_t pitch_px) {
+    uint64_t s[4] = {}, lit = 0;
+    for (uint32_t y = 0; y < h; y++)
+        for (uint32_t x = 0; x < w; x++) {
+            const uint8_t *q = p + ((size_t)y * pitch_px + x) * 4;
+            for (int c = 0; c < 4; c++) s[c] += q[c];
+            lit += (q[0] | q[1] | q[2]) > 8;
+        }
+    const double n = (double)w * h;
+    const uint8_t *m = p + ((size_t)(h / 2) * pitch_px + w / 2) * 4;
+    vt::logf("dk diag q%llu %s %08x %ux%u: média %.1f %.1f %.1f a %.1f, acesos %.1f%%, centro %u %u %u %u",
+             (unsigned long long)g_frame_no, what, addr, w, h, s[0] / n, s[1] / n, s[2] / n, s[3] / n, 100.0 * lit / n, m[0], m[1],
+             m[2], m[3]);
+}
+
+void diag_target(uint32_t addr) {
+    std::vector<uint8_t> px;
+    uint32_t w, h;
+    vt::logf("dk diag q%llu: %u alvos, %u texturas, escala %.3f", (unsigned long long)g_frame_no, (unsigned)g_targets.size(),
+             (unsigned)g_textures.size(), g_scale);
+    for (auto &kv : g_targets)
+        vt::logf("dk diag   alvo %08x guest %ux%u host %ux%u cenas %llu", kv.first, kv.second.gw, kv.second.gh, kv.second.color.w,
+                 kv.second.color.h, (unsigned long long)kv.second.cena);
+    if (!read_target(addr, px, w, h)) {
+        vt::logf("dk diag q%llu: %08x não é alvo", (unsigned long long)g_frame_no, addr);
+        return;
+    }
+    px_stats("alvo", addr, px.data(), w, h, w);
+    if (g_frame_no == 900) {
+        const std::string p = nxp::root_dir() + "/logs/dk_quadro.ppm";
+        if (std::FILE *f = std::fopen(p.c_str(), "wb")) {
+            std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+            for (size_t i = 0; i < (size_t)w * h; i++) std::fwrite(&px[4 * i], 1, 3, f);
+            std::fclose(f);
+            vt::logf("dk diag: quadro salvo em %s", p.c_str());
+        }
+    }
+}
+
+// Lê imagens do pós-processamento antes do envio (a apresentação segue depois, com o buffer de comandos novo).
+void fsr_diag(const DkImageView &screen) {
+    vt::logf("dk diag fsr: %s", g_fsr_info);
+    struct R { const char *nome; const DkImageView *v; DkImageView own; uint32_t w, h; };
+    R r[3] = {{"fsr fonte", nullptr, {}, 0, 0}, {"fsr easu", nullptr, {}, 0, 0}, {"fsr tela", &screen, {}, g_sw, g_sh}};
+    if (g_fsr_src && g_fsr_src->ok) dkImageViewDefaults(&r[0].own, &g_fsr_src->im), r[0].v = &r[0].own, r[0].w = g_fsr_src->w, r[0].h = g_fsr_src->h;
+    if (g_easu.ok) dkImageViewDefaults(&r[1].own, &g_easu.im), r[1].v = &r[1].own, r[1].w = g_easu.w, r[1].h = g_easu.h;
+    DkMemBlock mb[3] = {};
+    barrier(DkBarrier_Full, 0);
+    for (int i = 0; i < 3; i++) {
+        if (!r[i].v) continue;
+        mb[i] = mem_block(r[i].w * r[i].h * 4, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+        if (!mb[i]) continue;
+        const DkImageRect rc{0, 0, 0, r[i].w, r[i].h, 1};
+        const DkCopyBuf cb{dkMemBlockGetGpuAddr(mb[i]), 0, 0};
+        dkCmdBufCopyImageToBuffer(g_cmd, r[i].v, &rc, &cb, 0);
+    }
+    barrier(DkBarrier_Full, 0);
+    submit();
+    dkQueueWaitIdle(g_queue);
+    for (int i = 0; i < 3; i++) {
+        if (!mb[i]) {
+            vt::logf("dk diag fsr: %s sem imagem", r[i].nome);
+            continue;
+        }
+        px_stats(r[i].nome, 0, static_cast<const uint8_t *>(dkMemBlockGetCpuAddr(mb[i])), r[i].w, r[i].h, r[i].w);
+        dkMemBlockDestroy(mb[i]);
+    }
+    // de novo no g_easu com o shader em modo de teste: 1 = só a amostra da fonte, 2 = só a coordenada (sem textura)
+    if (!g_easu.ok || !g_fsr_cur || !g_fsr_cur->ok) return;
+    for (int m = 1; m <= 2; m++) {
+        float ub[12];
+        std::memcpy(ub, g_fsr_ub, sizeof ub);
+        ub[8] = (float)m;
+        DkImageView uv;
+        dkImageViewDefaults(&uv, &g_easu.im);
+        post_pass(uv, 0, 0, g_easu.w, g_easu.h, g_easu_fs, *g_fsr_cur, g_fsr_smp, ub, 12);
+        DkMemBlock b = mem_block(g_easu.w * g_easu.h * 4, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+        if (!b) return;
+        barrier(DkBarrier_Full, 0);
+        const DkImageRect rc{0, 0, 0, g_easu.w, g_easu.h, 1};
+        const DkCopyBuf cb{dkMemBlockGetGpuAddr(b), 0, 0};
+        dkCmdBufCopyImageToBuffer(g_cmd, &uv, &rc, &cb, 0);
+        barrier(DkBarrier_Full, 0);
+        submit();
+        dkQueueWaitIdle(g_queue);
+        px_stats(m == 1 ? "fsr easu cru" : "fsr easu coord", 0, static_cast<const uint8_t *>(dkMemBlockGetCpuAddr(b)), g_easu.w, g_easu.h, g_easu.w);
+        dkMemBlockDestroy(b);
+    }
+}
+
+bool present(uint32_t addr) {
+    std::unique_lock<std::recursive_mutex> lock(g_lock); // solto durante a espera da imagem da swapchain (abaixo)
+    if (!g_dev) return false;
+    bool diag = g_frame_no == 60 || (g_frame_no >= 300 && g_frame_no % 300 == 0);
+    if (diag) diag_target(addr);
+    DkMemBlock diag_mb = nullptr;
+    if (!g_swap && !create_swapchain()) return false;
+    win::pump();
+    if (win::take_resized() && !create_swapchain()) return false;
+#ifdef VITART_LSFG
+    if (g_vsync_dirty) dkSwapchainSetSwapInterval(g_swap, g_vsync || fg::g_mode ? 1 : 0), g_vsync_dirty = false;
+    const bool fg_tick = fg::should_generate();
+#else
+    if (g_vsync_dirty) dkSwapchainSetSwapInterval(g_swap, g_vsync ? 1 : 0), g_vsync_dirty = false;
+#endif
+    g_dw_last = g_dw_frame, g_dw_frame = 0;
+    nxmenu::update();
+    for (bool first = true;; first = false) {
+        if (!first) {
+            svcSleepThread(4000000);
+            nxmenu::update();
+            if (!nxmenu::active()) break;
+        }
+        // os desenhos do quadro vão para a GPU antes de esperar a imagem da swapchain (que segue o vsync)
+        // quadro do vídeo HD (NV12 de até 4K, ~12 MB) vai para o anel na apresentação
+        if (!reserve(g_vidn_px ? (24u << 20) : (8u << 20))) return false;
+        const Img *gen = nullptr; // quadro gerado (LSFG), apresentado antes do real
+#ifdef VITART_LSFG
+        if (first && fg::g_mode) {
+            auto ft = g_targets.find(addr);
+            if (ft == g_targets.end() || !ft->second.color.ok || g_vid_px || g_vidn_px || nxmenu::active()) fg::reset();
+            else if (fg_tick) mark(2), gen = fg::generate(ft->second.color);
+        }
+#endif
+        dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_slots[g_si].ts) + 32);
+        g_slots[g_si].mid = true;
+        submit();
+        for (int pass = gen ? 0 : 1; pass < 2; pass++) {
+            DKT("present %08x: acquire", addr);
+            // dkQueueAcquireImage = espera da janela (segue o vsync, até um quadro inteiro) + espera da fence na fila.
+            // A da janela não mexe na fila nem no buffer de comandos: roda sem g_lock, e a thread Render segue gravando
+            // o próximo quadro (antes ela parava em begin_scene/target_kind esperando esta thread). A swapchain só é
+            // tocada por esta thread. Na volta, o anel pode ter sido usado (ou a vaga trocada) pela Render: reserve de novo.
+            int slot = 0;
+            DkFence acq{};
+            const uint32_t wsi = g_si;
+            const bool wts = g_open;
+            if (wts) dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_slots[wsi].ts) + kWaitTs + 32 * pass), submit();
+            lock.unlock();
+            dkSwapchainAcquireImage(g_swap, &slot, &acq);
+            lock.lock();
+            dkQueueWaitFence(g_queue, &acq);
+            if (wts && g_open && g_si == wsi) {
+                dkCmdBufReportCounter(g_cmd, DkCounter_Timestamp, dkMemBlockGetGpuAddr(g_slots[wsi].ts) + kWaitTs + 32 * pass + 16);
+                g_slots[wsi].waits |= 1u << pass;
+            }
+            if (!reserve(g_vidn_px ? (24u << 20) : (8u << 20))) return false;
+            DKT("  imagem %d", slot);
+            DkImage &dst = g_swap_img[slot];
+            auto it = g_targets.find(addr);
+            Img *src = pass == 0 ? const_cast<Img *>(gen) : it != g_targets.end() ? &it->second.color : nullptr;
+            barrier(DkBarrier_Fragments, 0);
+            g_b.target = nullptr;
+            if (pass == 1 && g_vidn_px) {
+                if (nv12_pass()) src = &g_vid;
+                g_vidn_px = nullptr;
+            }
+            if (pass == 1 && g_vid_px) {
+                if (vid_img(g_vid_w, g_vid_h) && (uint64_t)g_vid_w * g_vid_h * 4 + g_ring_off < kRing) {
+                    const uint32_t off = ring_put(g_vid_px, g_vid_w * g_vid_h * 4, 256);
+                    DkImageView v;
+                    dkImageViewDefaults(&v, &g_vid.im);
+                    const DkCopyBuf cb{ring_gpu(off), 0, 0};
+                    const DkImageRect r{0, 0, 0, g_vid_w, g_vid_h, 1};
+                    dkCmdBufCopyBufferToImage(g_cmd, &cb, &v, &r, 0);
+                    barrier(DkBarrier_Full, 0);
+                    src = &g_vid;
+                }
+                g_vid_px = nullptr;
+            }
+            // retângulo na tela com a proporção do jogo (quase 16:9 estica para a tela inteira)
+            const double sw = g_sw, sh = g_sh, sa = src ? (double)src->w / src->h : sw / sh;
+            uint32_t dw = g_sw, dh = (uint32_t)(sw / sa + 0.5);
+            if (dh > g_sh) dh = g_sh, dw = (uint32_t)(sh * sa + 0.5);
+            if (std::fabs(sa / (sw / sh) - 1.0) < 0.015) dw = g_sw, dh = g_sh;
+            const uint32_t dx = (g_sw - dw) / 2, dy = (g_sh - dh) / 2;
+            DkImageView dv;
+            dkImageViewDefaults(&dv, &dst);
+            if (dw != g_sw || dh != g_sh || !src) {
+                dkCmdBufBindRenderTarget(g_cmd, &dv, nullptr);
+                const DkScissor sc{0, 0, g_sw, g_sh};
+                dkCmdBufSetScissors(g_cmd, 0, &sc, 1);
+                dkCmdBufClearColorFloat(g_cmd, 0, DkColorMask_RGBA, 0, 0, 0, 1);
+                barrier(DkBarrier_Fragments, 0);
+            }
+            if (src) {
+                DkImageView sv;
+                dkImageViewDefaults(&sv, &src->im);
+                // a borda que o meio pixel deixa sem desenho com escala > 1 (ver gxm_vk.cpp)
+                uint32_t ex = 0, ey = 0;
+                if (src != &g_vid && it != g_targets.end() && g_scale > 1.f) {
+                    ex = ey = std::min<uint32_t>(4, (uint32_t)std::ceil(0.5f * g_scale - 0.5f - 1e-3f));
+                }
+                const DkImageRect sr{ex, ey, 0, src->w - 2 * ex, src->h - 2 * ey, 1};
+                const DkImageRect dr{dx, dy, 0, dw, dh, 1};
+                if (!(post_on() && post_present(*src, ex, ey, dv, dx, dy, dw, dh)))
+                    dkCmdBufBlitImage(g_cmd, &sv, &sr, &dv, &dr, DkBlitFlag_FilterLinear | DkBlitFlag_ModeBlit, 0);
+            }
+            // overlays por cima (cópias depois do blit)
+            bool ovl_barrier = false;
+            auto before_ovl = [&] {
+                if (!ovl_barrier) barrier(DkBarrier_Full, 0), ovl_barrier = true;
+            };
+            {
+                static std::vector<uint32_t> text;
+                uint32_t w, h;
+                if (ovl::fps_frame(g_sh, text, w, h)) {
+                    before_ovl();
+                    const uint32_t m = g_sh / 60;
+                    blit_overlay(dst, text.data(), w, dx + m, dy + m, w, h);
+                }
+            }
+            {
+                const BannerImage *bi = nullptr;
+                int32_t x0 = 0, y0 = 0;
+                if (ovl::trophy_frame((int32_t)dx, (int32_t)dy, (int32_t)dw, (int32_t)dh, bi, x0, y0) && x0 >= 0 && y0 >= 0 &&
+                    x0 < (int32_t)g_sw && y0 + bi->h <= g_sh) {
+                    before_ovl();
+                    for (uint32_t y = 0; y < bi->h; y++) {
+                        const uint32_t from = y < bi->row_from.size() ? bi->row_from[y] : 0;
+                        uint32_t to = y < bi->row_to.size() ? bi->row_to[y] : bi->w;
+                        to = std::min<uint32_t>(to, g_sw - (uint32_t)x0);
+                        if (to > from) blit_overlay(dst, bi->px.data() + (size_t)y * bi->w + from, bi->w, x0 + from, y0 + y, to - from, 1);
+                    }
+                }
+            }
+            {
+                const uint32_t *px = nullptr;
+                uint32_t w = 0, h = 0;
+                bool dirty = false;
+                if (nxmenu::panel(g_sh, px, w, h, dirty) && w && h && w <= g_sw && h <= g_sh) {
+                    before_ovl();
+                    blit_overlay(dst, px, w, nxmenu::panel_x(g_sh), (g_sh - h) / 2, w, h);
+                }
+            }
+            if (pass == 0) {
+                submit();
+                dkQueuePresentImage(g_queue, g_swap, slot);
+                DKT("  gerado apresentado");
+                continue;
+            }
+            if (g_fsr_diag > 0 && --g_fsr_diag == 0) fsr_diag(dv);
+            if (diag && !diag_mb) {
+                diag_mb = mem_block(g_sw * g_sh * 4, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+                if (diag_mb) {
+                    barrier(DkBarrier_Full, 0);
+                    const DkImageRect r{0, 0, 0, g_sw, g_sh, 1};
+                    const DkCopyBuf cb{dkMemBlockGetGpuAddr(diag_mb), 0, 0};
+                    dkCmdBufCopyImageToBuffer(g_cmd, &dv, &r, &cb, 0);
+                }
+            }
+            slot_end();
+            dkQueuePresentImage(g_queue, g_swap, slot);
+            DKT("  apresentado");
+            if (diag_mb) {
+                dkQueueWaitIdle(g_queue);
+                px_stats("tela", addr, static_cast<const uint8_t *>(dkMemBlockGetCpuAddr(diag_mb)), g_sw, g_sh, g_sw);
+                dkMemBlockDestroy(diag_mb);
+                diag_mb = nullptr;
+                diag = false;
+            }
+            win::presented();
+        }
+        if (!nxmenu::active()) break;
+    }
+    g_frame_no++;
+    evict_textures();
+    return true;
+}
