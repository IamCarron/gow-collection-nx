+#version 450
+// FSR 1.0 EASU (AMD FidelityFX Super Resolution, MIT): amplia a imagem do jogo para o tamanho da tela com
+// realce de bordas. Versão escalar com 12 leituras inteiras (imageLoad), igual ao FsrEasuF de referência.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0, rgba8) uniform readonly image2D uSrc;
+layout(binding = 1, rgba8) uniform writeonly image2D uDst;
+layout(push_constant) uniform P { ivec4 sz; vec4 k; } pc; // sz = entrada w,h, saída w,h
+
+vec3 at(ivec2 p) { return imageLoad(uSrc, clamp(p, ivec2(0), pc.sz.xy - 1)).rgb; }
+float lum(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
+
+void tap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
+    vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x) * len;
+    float d2 = min(v.x * v.x + v.y * v.y, clp);
+    float wB = 2.0 / 5.0 * d2 - 1.0;
+    float wA = lob * d2 - 1.0;
+    wB *= wB;
+    wA *= wA;
+    wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
+    float w = wB * wA;
+    aC += c * w;
+    aW += w;
+}
+
+void setw(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+    float dc = lD - lC, cb = lC - lB;
+    float lenX = 1.0 / max(max(abs(dc), abs(cb)), 1e-5);
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+    lenX *= lenX;
+    len += lenX * w;
+    float ec = lE - lC, ca = lC - lA;
+    float lenY = 1.0 / max(max(abs(ec), abs(ca)), 1e-5);
+    float dirY = lE - lA;
+    dir.y += dirY * w;
+    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+    lenY *= lenY;
+    len += lenY * w;
+}
+
+void main() {
