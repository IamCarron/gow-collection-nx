+// vídeo da cena remasterizada (RGBA da CPU, ou NV12/P010 do NVDEC convertido na GPU por nv12_pass)
+const uint8_t *g_vid_px = nullptr;
+uint32_t g_vid_w = 0, g_vid_h = 0;
+const uint8_t *g_vidn_px = nullptr;
+uint32_t g_vidn_w = 0, g_vidn_h = 0, g_vidn_pitch = 0, g_vidn_uv = 0, g_vidn_flags = 0;
