+// ---------------------------------------------------------------- texturas
+struct Tex {
+    Img img;
+    uint64_t used = 0, born = 0;
+};
+std::unordered_map<uint64_t, Tex> g_textures;
+uint64_t g_frame_no = 0;
+Img g_white;
+
+void mip_down(const uint8_t *s, uint32_t w, uint32_t h, std::vector<uint8_t> &d, uint32_t &nw, uint32_t &nh) {
+    nw = std::max(1u, w / 2), nh = std::max(1u, h / 2);
+    d.resize((size_t)nw * nh * 4);
+    for (uint32_t y = 0; y < nh; y++)
+        for (uint32_t x = 0; x < nw; x++) {
+            const uint32_t x0 = std::min(2 * x, w - 1), x1 = std::min(2 * x + 1, w - 1);
+            const uint32_t y0 = std::min(2 * y, h - 1), y1 = std::min(2 * y + 1, h - 1);
+            for (int c = 0; c < 4; c++)
+                d[((size_t)y * nw + x) * 4 + c] =
+                    (uint8_t)((s[((size_t)y0 * w + x0) * 4 + c] + s[((size_t)y0 * w + x1) * 4 + c] + s[((size_t)y1 * w + x0) * 4 + c] +
+                               s[((size_t)y1 * w + x1) * 4 + c] + 2) >> 2);
+        }
+}
+
+// Envio na lista de envio (antes dos desenhos da vaga). O chamador já reservou o anel.
+void upload_level(Img &im, uint32_t level, const uint8_t *px, uint32_t w, uint32_t h) {
+    const uint32_t off = ring_put(px, w * h * 4, 256);
+    DkImageView v;
+    dkImageViewDefaults(&v, &im.im);
+    v.mipLevelOffset = (uint8_t)level, v.mipLevelCount = 1;
+    const DkCopyBuf src{ring_gpu(off), 0, 0};
+    const DkImageRect r{0, 0, 0, w, h, 1};
+    dkCmdBufCopyBufferToImage(g_up, &src, &v, &r, 0);
+    g_up_any = true;
+}
+
+bool upload_texture(Img &im, uint32_t w, uint32_t h, const uint8_t *rgba, bool mipped) {
+    DKT("textura %ux%u mip %d", w, h, (int)mipped);
+    uint32_t mips = 1;
+    if (mipped)
+        while ((w | h) >> mips) mips++;
+    {
+        Timer t(g_stats.alloc_ns);
+        if (!img_make(im, w, h, kColor, DkImageFlags_Usage2DEngine, mips)) return false;
+    }
+    upload_level(im, 0, rgba, w, h);
+    std::vector<uint8_t> a, b;
+    const uint8_t *cur = rgba;
+    uint32_t cw = w, ch = h;
+    for (uint32_t l = 1; l < mips; l++) {
+        uint32_t nw, nh;
+        mip_down(cur, cw, ch, a, nw, nh);
+        upload_level(im, l, a.data(), nw, nh);
+        std::swap(a, b);
+        cur = b.data(), cw = nw, ch = nh;
+    }
+    g_stats.uploads++;
+    return true;
+}
+
+// Texturas sem uso há muito tempo saem (a GPU já passou por elas há centenas de quadros).
+// Texturas de um quadro só (quadros do Bink, conteúdo que muda todo quadro) saem logo: sem isso o vídeo cria
+// 3 texturas novas por quadro e a memória acaba em poucos minutos.
+void evict_textures() {
+    if (g_frame_no % 30) return;
+    const bool full = g_frame_no % 600 == 0 && g_textures.size() >= 512;
+    for (auto it = g_textures.begin(); it != g_textures.end();)
+        if (g_frame_no - it->second.used > (it->second.used - it->second.born <= 2 ? 60u : full ? 1800u : UINT64_MAX)) {
+            img_free(it->second.img);
+            it = g_textures.erase(it);
+        } else {
+            ++it;
+        }
+}
+
+// ---------------------------------------------------------------- swapchain
+constexpr uint32_t kSwapImages = 3;
+DkMemBlock g_swap_mem = nullptr;
+DkImage g_swap_img[kSwapImages];
+DkSwapchain g_swap = nullptr;
+uint32_t g_sw = 1280, g_sh = 720;
+bool g_vsync = true, g_vsync_dirty = false;
+
+void destroy_swapchain() {
+    if (!g_swap) return;
+    dkQueueWaitIdle(g_queue);
+    dkSwapchainDestroy(g_swap);
+    dkMemBlockDestroy(g_swap_mem);
+    g_swap = nullptr, g_swap_mem = nullptr;
+}
+
+bool create_swapchain() {
+    destroy_swapchain();
+    int x, y, w, h;
+    if (win::rect(x, y, w, h)) g_sw = (uint32_t)w, g_sh = (uint32_t)h;
+    DkImageLayoutMaker lm;
+    dkImageLayoutMakerDefaults(&lm, g_dev);
+    lm.flags = DkImageFlags_UsageRender | DkImageFlags_UsagePresent | DkImageFlags_Usage2DEngine;
+    lm.format = DkImageFormat_RGBA8_Unorm;
+    lm.dimensions[0] = g_sw, lm.dimensions[1] = g_sh;
+    DkImageLayout lay;
+    dkImageLayoutInitialize(&lay, &lm);
+    const uint32_t align = dkImageLayoutGetAlignment(&lay);
+    const uint32_t sz = ((uint32_t)dkImageLayoutGetSize(&lay) + align - 1) & ~(align - 1);
+    g_swap_mem = mem_block(sz * kSwapImages, DkMemBlockFlags_GpuCached | DkMemBlockFlags_Image);
+    if (!g_swap_mem) return fail("sem memória para a swapchain");
+    const DkImage *ptrs[kSwapImages];
+    for (uint32_t i = 0; i < kSwapImages; i++) {
+        dkImageInitialize(&g_swap_img[i], &lay, g_swap_mem, i * sz);
+        ptrs[i] = &g_swap_img[i];
+    }
+    DkSwapchainMaker sm;
+    dkSwapchainMakerDefaults(&sm, g_dev, win::hwnd(), ptrs, kSwapImages);
+    g_swap = dkSwapchainCreate(&sm);
+    if (!g_swap) return fail("dkSwapchainCreate falhou");
+    dkSwapchainSetSwapInterval(g_swap, g_vsync ? 1 : 0);
+    vt::logf("dk: swapchain %ux%u", g_sw, g_sh);
+    return true;
+}
+
+// Overlay BGRA da CPU num retângulo da imagem da swapchain (RGBA): troca R e B ao copiar para o anel.
+void blit_overlay(DkImage &dst, const uint32_t *px, uint32_t stride, uint32_t x, uint32_t y, uint32_t w, uint32_t h) {
+    if (!w || !h || x + w > g_sw || y + h > g_sh) return;
+    const uint32_t off = ring_put(nullptr, w * h * 4, 256);
+    uint32_t *o = reinterpret_cast<uint32_t *>(g_slots[g_si].ring_cpu + off);
+    for (uint32_t r = 0; r < h; r++)
+        for (uint32_t c = 0; c < w; c++) {
+            const uint32_t p = px[(size_t)r * stride + c];
+            o[(size_t)r * w + c] = (p & 0xFF00FF00u) | ((p >> 16) & 0xFF) | ((p & 0xFF) << 16);
+        }
+    DkImageView v;
+    dkImageViewDefaults(&v, &dst);
+    const DkCopyBuf src{ring_gpu(off), 0, 0};
+    const DkImageRect r{x, y, 0, w, h, 1};
+    dkCmdBufCopyBufferToImage(g_cmd, &src, &v, &r, 0);
+}
