diff --git a/runtime/vitart/fragment_effects.h b/runtime/vitart/fragment_effects.h
new file mode 100644
index 0000000..a3730bc
--- /dev/null
+++ b/runtime/vitart/fragment_effects.h
@@ -0,0 +1,57 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+// Conservative SPIR-V analysis for draws with colorWriteMask == 0.
+// Unknown pointer stores, operations or execution modes keep the fragment shader.
+// Never remove discard, depth/sample-mask writes, atomics or storage writes.
+static inline bool fragment_color_only(const uint32_t *code, uint32_t bytes) {
+    if (!code || bytes % 4 || bytes < 20 || code[0] != 0x07230203u) return false;
+    const uint32_t n = bytes / 4, bound = code[3];
+    if (!bound || bound > 1000000) return false;
+    std::vector<uint8_t> safe(bound), location(bound), builtin(bound), glsl(bound);
+    bool fragment = false;
+    for (uint32_t i = 5; i < n;) {
+        const uint32_t wc = code[i] >> 16, op = code[i] & 65535;
+        if (!wc || wc > n - i) return false;
+        const uint32_t *p = code + i;
+        // Core arithmetic, types, loads and image reads are side-effect free. Explicitly
+        // reject writes/calls/copies; only known control flow is accepted above opcode 200.
+        if (op > 200 && !(op >= 245 && op <= 251) && !(op >= 253 && op <= 255)) return false;
+        if (op == 57 || op == 63 || op == 64 || op == 99) return false;
+        if (op == 11) { // OpExtInstImport: only GLSL.std.450 (no debug/unknown instruction sets)
+            static const char name[] = "GLSL.std.450";
+            if (wc != 6 || p[1] >= bound || std::memcmp(p + 2, name, sizeof name)) return false;
+            glsl[p[1]] = 1;
+        } else if (op == 12) { // Modf/Frexp pointer-output forms are not pure.
+            if (wc < 5 || p[3] >= bound || !glsl[p[3]] || !p[4] || p[4] > 81 || p[4] == 35 || p[4] == 51) return false;
+        } else if (op == 14) { // OpMemoryModel: Logical addressing only.
+            if (wc != 3 || p[1] != 0) return false;
+        } else if (op == 15) {
+            if (wc < 4 || p[1] != 4) return false; // Fragment entry points only.
+            fragment = true;
+        } else if (op == 16) {
+            // OriginUpperLeft and EarlyFragmentTests do not replace depth/coverage.
+            if (wc != 3 || (p[2] != 7 && p[2] != 9)) return false;
+        } else if (op == 71) { // OpDecorate
+            if (wc < 3 || p[1] >= bound) return false;
+            if (p[2] == 11) builtin[p[1]] = 1;
+            if (p[2] == 30) location[p[1]] = 1;
+        } else if (op == 72) { // No built-in interface blocks or decoration groups.
+            if (wc < 4 || p[3] == 11) return false;
+        } else if (op >= 73 && op <= 75) return false;
+        else if (op == 59) { // OpVariable: Private, Function, or ordinary color Output.
+            if (wc < 4 || p[2] >= bound) return false;
+            safe[p[2]] = p[3] == 6 || p[3] == 7 || (p[3] == 3 && location[p[2]] && !builtin[p[2]]);
+        } else if (op == 65 || op == 66 || op == 67 || op == 70 || op == 83) {
+            // Access chains and pointer copies inherit the base variable's classification.
+            if (wc < 4 || p[2] >= bound || p[3] >= bound) return false;
+            safe[p[2]] = safe[p[3]];
+        } else if (op == 62) {
+            if (wc < 3 || p[1] >= bound || !safe[p[1]]) return false;
+        }
+        i += wc;
+    }
+    return fragment;
+}
diff --git a/runtime/vitart/fsr/fsr_easu.comp b/runtime/vitart/fsr/fsr_easu.comp
new file mode 100644
index 0000000..ae2ed9d
--- /dev/null
+++ b/runtime/vitart/fsr/fsr_easu.comp
@@ -0,0 +1,94 @@
+#version 450
+// FSR 1.0 EASU (AMD FidelityFX Super Resolution, MIT): amplia a imagem do jogo para o tamanho da tela com
+// realce de bordas. Versão escalar com 12 leituras inteiras (imageLoad), igual ao FsrEasuF de referência.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0, rgba8) uniform readonly image2D uSrc;
+layout(binding = 1, rgba8) uniform writeonly image2D uDst;
+layout(push_constant) uniform P { ivec4 sz; vec4 k; } pc; // sz = entrada w,h, saída w,h
+
+vec3 at(ivec2 p) { return imageLoad(uSrc, clamp(p, ivec2(0), pc.sz.xy - 1)).rgb; }
+float lum(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
+
+void tap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
+    vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x) * len;
+    float d2 = min(v.x * v.x + v.y * v.y, clp);
+    float wB = 2.0 / 5.0 * d2 - 1.0;
+    float wA = lob * d2 - 1.0;
+    wB *= wB;
+    wA *= wA;
+    wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
+    float w = wB * wA;
+    aC += c * w;
+    aW += w;
+}
+
+void setw(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+    float dc = lD - lC, cb = lC - lB;
+    float lenX = 1.0 / max(max(abs(dc), abs(cb)), 1e-5);
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+    lenX *= lenX;
+    len += lenX * w;
+    float ec = lE - lC, ca = lC - lA;
+    float lenY = 1.0 / max(max(abs(ec), abs(ca)), 1e-5);
+    float dirY = lE - lA;
+    dir.y += dirY * w;
+    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+    lenY *= lenY;
+    len += lenY * w;
+}
+
+void main() {
+    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
+    if (o.x >= pc.sz.z || o.y >= pc.sz.w) return;
+    vec2 pp = (vec2(o) + 0.5) * vec2(pc.sz.xy) / vec2(pc.sz.zw) - 0.5;
+    vec2 fp = floor(pp);
+    pp -= fp;
+    ivec2 f0 = ivec2(fp);
+    //    b c
+    //  e f g h
+    //  i j k l
+    //    n o
+    vec3 b = at(f0 + ivec2(0, -1)), c = at(f0 + ivec2(1, -1));
+    vec3 e = at(f0 + ivec2(-1, 0)), f = at(f0), g = at(f0 + ivec2(1, 0)), h = at(f0 + ivec2(2, 0));
+    vec3 i = at(f0 + ivec2(-1, 1)), j = at(f0 + ivec2(0, 1)), k = at(f0 + ivec2(1, 1)), l = at(f0 + ivec2(2, 1));
+    vec3 n = at(f0 + ivec2(0, 2)), oo = at(f0 + ivec2(1, 2));
+    float bL = lum(b), cL = lum(c), eL = lum(e), fL = lum(f), gL = lum(g), hL = lum(h);
+    float iL = lum(i), jL = lum(j), kL = lum(k), lL = lum(l), nL = lum(n), oL = lum(oo);
+    vec2 dir = vec2(0.0);
+    float len = 0.0;
+    setw(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+    setw(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+    setw(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+    setw(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+    vec2 dir2 = dir * dir;
+    float dirR = dir2.x + dir2.y;
+    bool zro = dirR < 1.0 / 32768.0;
+    dirR = zro ? 1.0 : inversesqrt(dirR);
+    dir.x = zro ? 1.0 : dir.x;
+    dir *= dirR;
+    len = len * 0.5;
+    len *= len;
+    float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+    vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    float clp = 1.0 / lob;
+    vec3 mn4 = min(min(f, g), min(j, k)), mx4 = max(max(f, g), max(j, k));
+    vec3 aC = vec3(0.0);
+    float aW = 0.0;
+    tap(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+    tap(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
+    tap(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
+    tap(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+    tap(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+    tap(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+    tap(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+    tap(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+    tap(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+    tap(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+    tap(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, oo);
+    tap(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+    vec3 pix = min(mx4, max(mn4, aC / aW));
+    imageStore(uDst, o, vec4(pix, 1.0));
+}
diff --git a/runtime/vitart/fsr/fsr_rcas.comp b/runtime/vitart/fsr/fsr_rcas.comp
new file mode 100644
index 0000000..7fba62c
--- /dev/null
+++ b/runtime/vitart/fsr/fsr_rcas.comp
@@ -0,0 +1,30 @@
+#version 450
+// FSR 1.0 RCAS (AMD FidelityFX, MIT): nitidez adaptativa por contraste depois do EASU.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0, rgba8) uniform readonly image2D uSrc;
+layout(binding = 1, rgba8) uniform writeonly image2D uDst;
+layout(push_constant) uniform P { ivec4 sz; vec4 k; } pc; // sz.zw = tamanho; k.x = exp2(-nitidez em stops)
+
+vec3 at(ivec2 p) { return imageLoad(uSrc, clamp(p, ivec2(0), pc.sz.zw - 1)).rgb; }
+
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x >= pc.sz.z || p.y >= pc.sz.w) return;
+    //   b
+    // d e f
+    //   h
+    vec3 b = at(p + ivec2(0, -1)), d = at(p + ivec2(-1, 0)), e = at(p), f = at(p + ivec2(1, 0)), h = at(p + ivec2(0, 1));
+    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
+    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
+    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
+    vec3 lobeRGB = max(-hitMin, hitMax);
+    float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.k.x;
+    // remoção de ruído do RCAS: menos nitidez onde o pixel destoa dos vizinhos
+    float bL = b.b * 0.5 + (b.r * 0.5 + b.g), dL = d.b * 0.5 + (d.r * 0.5 + d.g), eL = e.b * 0.5 + (e.r * 0.5 + e.g);
+    float fL = f.b * 0.5 + (f.r * 0.5 + f.g), hL = h.b * 0.5 + (h.r * 0.5 + h.g);
+    float nz = 0.25 * (bL + dL + fL + hL) - eL;
+    nz = clamp(abs(nz) / max(max(max(bL, dL), max(eL, max(fL, hL))) - min(min(bL, dL), min(eL, min(fL, hL))), 1e-5), 0.0, 1.0);
+    lobe *= -0.5 * nz + 1.0;
+    vec3 pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
+    imageStore(uDst, p, vec4(clamp(pix, 0.0, 1.0), 1.0));
+}
