+    setw(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+    setw(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+    setw(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
