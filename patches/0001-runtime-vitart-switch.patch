+void set_gfx(uint32_t id, uint32_t v) {
+    if (id >= kGfxCount) return;
+    static const uint32_t kMax[kGfxCount] = {1, 1, 10, 16, 8, 8, 2, 1};
+    v = std::min(v, kMax[id]);
+    if (id == kGfxAniso) {
+        v = v >= 16 ? 16 : v >= 8 ? 8 : v >= 4 ? 4 : v >= 2 ? 2 : 1;
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        g_aniso = v; // samplers novos daqui em diante; os desenhos pedem pela chave a cada quadro
+    }
+    if (g_gfx[id].exchange(v) != v) {
+        vt::logf("dk: opção gráfica %u = %u", id, v);
+        if (id == kGfxUpscale && v) g_fsr_diag = 3;
+    }
