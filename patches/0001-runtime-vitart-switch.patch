--- /dev/null
+++ b/runtime/vitart/fsr/snap_r32f.comp
@@ -0,0 +1,12 @@
+#version 450
+// Cópia de alvo (gxm_vk.cpp, copiar_snap): lê o alvo amostrando e grava a cópia como storage. No NVK do Maxwell a
+// cópia por vkCmdCopyImage da profundidade D32S8 custava ~2 ms a 1152x720; por compute sai no custo da banda.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0) uniform sampler2D uSrc;
+layout(binding = 1, r32f) uniform writeonly image2D uDst;
+layout(push_constant) uniform P { ivec2 sz; } pc;
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x >= pc.sz.x || p.y >= pc.sz.y) return;
+    imageStore(uDst, p, texelFetch(uSrc, p, 0));
+}
