diff --git a/runtime/vitart/upload_copy.h b/runtime/vitart/upload_copy.h
new file mode 100644
index 0000000..1b1e99e
--- /dev/null
+++ b/runtime/vitart/upload_copy.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#if defined(__SWITCH__) && defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+// Uploads do anel não se sobrepõem à origem. No Switch, stores vetoriais alinhados
+// reduzem as instruções por bloco em relação ao memcpy escalar do newlib.
+// Nunca lê/escreve fora do intervalo; não usa instruções de cache/DC ZVA.
+static inline void upload_copy(void *dst, const void *src, size_t n) {
+#if defined(__SWITCH__) && defined(__aarch64__)
+    if (n >= 256) {
+        auto *d = static_cast<uint8_t *>(dst);
+        const auto *s = static_cast<const uint8_t *>(src);
+        while (reinterpret_cast<uintptr_t>(d) & 15) {
+            *d++ = *s++;
+            --n;
+        }
+        while (n >= 64) {
+            const uint8x16_t a = vld1q_u8(s), b = vld1q_u8(s + 16);
+            const uint8x16_t c = vld1q_u8(s + 32), e = vld1q_u8(s + 48);
+            vst1q_u8(d, a); vst1q_u8(d + 16, b);
+            vst1q_u8(d + 32, c); vst1q_u8(d + 48, e);
+            s += 64; d += 64; n -= 64;
+        }
+        while (n >= 16) {
+            vst1q_u8(d, vld1q_u8(s));
+            s += 16; d += 16; n -= 16;
+        }
+        while (n--) *d++ = *s++;
+        return;
+    }
+#endif
+    if (n) std::memcpy(dst, src, n);
+}
