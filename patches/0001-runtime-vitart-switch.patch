+constexpr uint32_t kRecCap = 4096;
+RecOp *g_rq = nullptr;
+RecOp g_rq_local; // gravação na própria thread (fila desligada)
+bool g_rec_on = false;
+std::atomic<uint32_t> g_rq_head{0}, g_rq_tail{0};
+std::atomic<bool> g_rq_sleep{false}, g_rq_wait{false};
+std::mutex g_rq_m;
+std::condition_variable g_rq_work, g_rq_done;
+std::atomic<uint64_t> g_rec_ns{0}, g_sync_ns{0};
+
+void rec_exec(const RecOp &o) {
+    const VkCommandBuffer c = o.cmd;
+    if (o.kind == 1) {
+        VkRenderPassBeginInfo rbi{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        rbi.renderPass = g_rp;
+        rbi.framebuffer = o.fb;
