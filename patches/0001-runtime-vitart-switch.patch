+    if (o.flags & (1u << 18)) vkCmdSetStencilWriteMask(c, VK_STENCIL_FACE_FRONT_BIT, o.sten[2]);
+    if (o.flags & (1u << 19)) vkCmdSetStencilWriteMask(c, VK_STENCIL_FACE_BACK_BIT, o.sten[3]);
+    if (o.flags & (1u << 20)) vkCmdSetStencilReference(c, VK_STENCIL_FACE_FRONT_BIT, o.sten[4]);
+    if (o.flags & (1u << 21)) vkCmdSetStencilReference(c, VK_STENCIL_FACE_BACK_BIT, o.sten[5]);
