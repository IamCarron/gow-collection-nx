+bool read_target(uint32_t addr, std::vector<uint8_t> &rgba, uint32_t &w, uint32_t &h) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    DKT("read_target %08x", addr);
+    auto it = g_targets.find(addr);
+    if (!g_dev || it == g_targets.end() || !reserve(1024)) return false;
+    Img &im = it->second.color;
+    w = im.w, h = im.h;
+    DkMemBlock mb = mem_block(w * h * 4, DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached);
+    if (!mb) return false;
+    barrier(DkBarrier_Full, 0);
+    DkImageView v;
+    dkImageViewDefaults(&v, &im.im);
+    const DkImageRect r{0, 0, 0, w, h, 1};
+    const DkCopyBuf dst{dkMemBlockGetGpuAddr(mb), 0, 0};
+    dkCmdBufCopyImageToBuffer(g_cmd, &v, &r, &dst, 0);
+    slot_end();
+    dkQueueWaitIdle(g_queue);
+    rgba.resize((size_t)w * h * 4);
+    std::memcpy(rgba.data(), dkMemBlockGetCpuAddr(mb), rgba.size());
+    dkMemBlockDestroy(mb);
+    return true;
+}
+
+void draw_enemy_bars(uint32_t color_addr, const EnemyBar *bars, uint32_t n) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    auto it = g_targets.find(color_addr);
+    if (!g_dev || !n || it == g_targets.end()) return;
+    Img &im = it->second.color;
+    if (!reserve(n * (im.h * im.h / 64 * 4 + 64 * 1024))) return;
+    std::vector<uint32_t> px;
+    std::vector<Span> spans;
+    bool first = true;
+    DkImageView v;
+    dkImageViewDefaults(&v, &im.im);
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t bw, bh;
+        int32_t x0, y0;
+        if (!ovl::enemy_bar(im.w, im.h, bars[i], px, bw, bh, x0, y0, spans)) continue;
+        if (first) barrier(DkBarrier_Full, 0), first = false;
+        for (const Span &s : spans) {
+            const uint32_t off = ring_put(px.data() + (size_t)s.y * bw + s.x, s.w * 4, 256);
+            const DkCopyBuf cb{ring_gpu(off), 0, 0};
+            const DkImageRect r{(uint32_t)(x0 + (int32_t)s.x), (uint32_t)(y0 + (int32_t)s.y), 0, s.w, 1, 1};
+            dkCmdBufCopyBufferToImage(g_cmd, &cb, &v, &r, 0);
+        }
+    }
+    if (!first) barrier(DkBarrier_Full, DkInvalidateFlags_Image | DkInvalidateFlags_L2Cache);
+}
