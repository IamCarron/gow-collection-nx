diff --git a/runtime/vitart/fsr/fsr_rcas.comp b/runtime/vitart/fsr/fsr_rcas.comp
new file mode 100644
index 0000000..7fba62c
--- /dev/null
+++ b/runtime/vitart/fsr/fsr_rcas.comp
@@ -0,0 +1,30 @@
+#version 450
+// FSR 1.0 RCAS (AMD FidelityFX, MIT): nitidez adaptativa por contraste depois do EASU.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0, rgba8) uniform readonly image2D uSrc;
+layout(binding = 1, rgba8) uniform writeonly image2D uDst;
+layout(push_constant) uniform P { ivec4 sz; vec4 k; } pc; // sz.zw = tamanho; k.x = exp2(-nitidez em stops)
+
+vec3 at(ivec2 p) { return imageLoad(uSrc, clamp(p, ivec2(0), pc.sz.zw - 1)).rgb; }
+
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x >= pc.sz.z || p.y >= pc.sz.w) return;
+    //   b
+    // d e f
+    //   h
+    vec3 b = at(p + ivec2(0, -1)), d = at(p + ivec2(-1, 0)), e = at(p), f = at(p + ivec2(1, 0)), h = at(p + ivec2(0, 1));
+    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
+    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
+    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
+    vec3 lobeRGB = max(-hitMin, hitMax);
+    float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.k.x;
+    // remoção de ruído do RCAS: menos nitidez onde o pixel destoa dos vizinhos
+    float bL = b.b * 0.5 + (b.r * 0.5 + b.g), dL = d.b * 0.5 + (d.r * 0.5 + d.g), eL = e.b * 0.5 + (e.r * 0.5 + e.g);
+    float fL = f.b * 0.5 + (f.r * 0.5 + f.g), hL = h.b * 0.5 + (h.r * 0.5 + h.g);
+    float nz = 0.25 * (bL + dL + fL + hL) - eL;
+    nz = clamp(abs(nz) / max(max(max(bL, dL), max(eL, max(fL, hL))) - min(min(bL, dL), min(eL, min(fL, hL))), 1e-5), 0.0, 1.0);
+    lobe *= -0.5 * nz + 1.0;
+    vec3 pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
+    imageStore(uDst, p, vec4(clamp(pix, 0.0, 1.0), 1.0));
+}
diff --git a/runtime/vitart/fsr/nv12_rgba.comp b/runtime/vitart/fsr/nv12_rgba.comp
new file mode 100644
index 0000000..a6e5fcd
--- /dev/null
+++ b/runtime/vitart/fsr/nv12_rgba.comp
@@ -0,0 +1,31 @@
+#version 450
+// Cena remasterizada no Switch (video_hd_nx.cpp): quadro NV12 (ou P010) do NVDEC, num buffer, -> RGBA.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(std430, binding = 0) readonly buffer B { uint d[]; } src;
+layout(binding = 1, rgba8) uniform writeonly image2D uDst;
+// sz = largura, altura, pitch (bytes), início do plano UV (bytes)
+// fl.x = 1 se P010 (16 bits por amostra), fl.y = 1 se faixa cheia, fl.z = 1 se BT.601 (senão BT.709)
+layout(push_constant) uniform P { ivec4 sz; ivec4 fl; } pc;
+
+float smp(int off) {
+    uint w = src.d[off >> 2];
+    if (pc.fl.x != 0) return float((w >> ((off & 2) * 8)) & 0xffffu) / 65535.0;
+    return float((w >> ((off & 3) * 8)) & 0xffu) / 255.0;
+}
+
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x >= pc.sz.x || p.y >= pc.sz.y) return;
+    int bps = pc.fl.x != 0 ? 2 : 1;
+    float y = smp(p.y * pc.sz.z + p.x * bps);
+    int uv = pc.sz.w + (p.y >> 1) * pc.sz.z + (p.x >> 1) * 2 * bps;
+    float u = smp(uv) - 0.5, v = smp(uv + bps) - 0.5;
+    if (pc.fl.y == 0) {
+        y = (y - 16.0 / 255.0) * (255.0 / 219.0);
+        u *= 255.0 / 224.0;
+        v *= 255.0 / 224.0;
+    }
+    vec3 c = pc.fl.z != 0 ? vec3(y + 1.402 * v, y - 0.344136 * u - 0.714136 * v, y + 1.772 * u)
+                          : vec3(y + 1.5748 * v, y - 0.1873 * u - 0.4681 * v, y + 1.8556 * u);
+    imageStore(uDst, p, vec4(clamp(c, 0.0, 1.0), 1.0));
+}
diff --git a/runtime/vitart/fsr/snap_r32f.comp b/runtime/vitart/fsr/snap_r32f.comp
new file mode 100644
