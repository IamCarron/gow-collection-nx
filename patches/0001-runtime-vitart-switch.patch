+// Formato: "SPVPAK1\0", u32 n, n x {char nome[28], u32 tamanho, u64 offset}, dados.
+struct SpvPak {
+    std::FILE *f = nullptr;
+    std::unordered_map<std::string, std::pair<uint64_t, uint32_t>> idx;
+    std::mutex m;
